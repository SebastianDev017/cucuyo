{% doc %}
  Emits one element's typography and colour overrides as inline CSS custom
  properties: a declaration fragment for a style="" attribute (no selector).
  It reads the settings generated by the type and color fragments
  (scripts/schema/fragments, EDITOR-ARCHITECTURE.md §5.2, §5.3, §5.8) and
  emits ONLY what is set, so an untouched element gets an empty string and
  the CSS chains fall through to the style tokens and today's literals:
  font-size: var(--card-label-size, var(--t-card-label-size, <literal>)).

  - <p>_type is the designed style (or blank): nothing for the type, except
    a face chosen in <p>_font (or the kept face select, e.g. label_font,
    whose 'heading' / 'body' values give exactly what font-vars gave).
  - <p>_type is another style: --<v>-font, -weight, -size, -size-m, -lh,
    -ls and -case all point at that style's tokens (--t-<style>-*).
  - <p>_adjust ticked: the fine values that are set (weight, size % of the
    style's designed size, phone size % — left at 100 it follows the desktop
    % —, line height, letter spacing, case) override those. A face chosen
    while another style is picked applies only with fine-tune on. Weight is
    skipped for Persona (one weight) unless custom fonts are on.
  - colours, whenever set: <p>_color → --<v>-ink, <p>_hover_color →
    --<v>-hover-ink, <p>_bg → --<v>-bg, <p>_hover_bg → --<v>-hover-bg,
    <p>_border → --<v>-border, <p>_hover_border → --<v>-hover-border.

  @param {object} [s] - Settings drop of the element: block.settings or section.settings (never a param named settings)
  @param {string} [p] - Id prefix of the group, e.g. 'label' (label_type, label_font, label_color…)
  @param {string} v - CSS variable prefix, e.g. 'card-label' (--card-label-size…)
  @param {string} [style] - The designed style id, e.g. 'card-label' (the default of <p>_type)
  @param {string} [alias_font] - Id of the face select when it is not <p>_font
  @param {string} [alias_color] - Id of the text colour when it is not <p>_color
  @param {string} [alias_hover_color] - Id of the hover text colour when it is not <p>_hover_color
  @param {string} [alias_bg] - Id of the background colour when it is not <p>_bg
  @param {string} [alias_hover_bg] - Id of the hover background when it is not <p>_hover_bg
  @param {string} [alias_border] - Id of the border colour when it is not <p>_border
  @param {string} [alias_hover_border] - Id of the hover border colour when it is not <p>_hover_border
  @param {string} [font] - A face value used instead of the settings: heading | body | persona | junction (font-vars passes it)
  @example
  <span class="card-caption" style="{% render 'el-style', s: block.settings, p: 'label', v: 'card-label', style: 'card-label' %}">
{% enddoc %}

{%- liquid
  assign f_font = ''
  assign f_weight = ''
  assign f_size = ''
  assign f_size_m = ''
  assign f_lh = ''
  assign f_ls = ''
  assign f_case = ''
  assign eff_face = ''
  assign changed = false
  assign adjust = false
  assign face = font
  assign t = style
  assign has_settings = false
  if s != blank and p != blank
    assign has_settings = true
  endif

  if has_settings
    assign k = p | append: '_type'
    if s[k] != blank
      assign t = s[k]
    endif
    if style != blank and t != style
      assign changed = true
    endif
    assign k = p | append: '_adjust'
    if s[k]
      assign adjust = true
    endif
    if face == blank
      assign k = p | append: '_font'
      if alias_font != blank
        assign k = alias_font
      endif
      assign face = s[k]
    endif
  endif

  if changed
    assign tok = 'var(--t-' | append: t
    assign f_font = tok | append: '-font)'
    assign f_weight = tok | append: '-weight)'
    assign f_size = tok | append: '-size)'
    assign f_size_m = tok | append: '-size-m)'
    assign f_lh = tok | append: '-lh)'
    assign f_ls = tok | append: '-ls)'
    assign f_case = tok | append: '-case)'
  endif

  assign face_active = true
  if changed and adjust == false
    assign face_active = false
  endif
  if face_active
    case face
      when 'heading', 'persona'
        assign f_font = 'var(--font-heading)'
        assign f_weight = 'var(--font-heading-weight, 500)'
        assign eff_face = 'persona'
      when 'body', 'junction'
        assign f_font = 'var(--font-body)'
        assign f_weight = '400'
        assign eff_face = 'junction'
    endcase
  endif

  if adjust and t != blank
    if eff_face == blank
      assign k = 'type_' | append: t | replace: '-', '_' | append: '_font'
      assign eff_face = settings[k]
    endif
    assign k = p | append: '_weight'
    assign val = s[k]
    if val != blank and val != 'inherit'
      if eff_face == 'junction' or settings.use_custom_fonts
        assign f_weight = val
      endif
    endif
    assign k = p | append: '_size'
    assign pct = s[k] | default: 100
    assign k = p | append: '_size_m'
    assign pct_m = s[k] | default: 100
    if pct_m == 100
      assign pct_m = pct
    endif
    if pct != 100
      assign f_size = 'calc(var(--t-' | append: t | append: '-base) * ' | append: pct | append: ' / 100)'
    endif
    if pct_m != 100
      assign f_size_m = 'calc(var(--t-' | append: t | append: '-base-m) * ' | append: pct_m | append: ' / 100)'
    endif
    assign k = p | append: '_lh'
    assign val = s[k]
    if val != blank and val != 'inherit'
      assign f_lh = val
    endif
    assign k = p | append: '_ls'
    assign val = s[k]
    if val != blank and val != 'inherit'
      assign f_ls = val
    endif
    assign k = p | append: '_case'
    assign val = s[k]
    if val != blank and val != 'inherit'
      assign f_case = val
    endif
  endif

  assign out = ''
  if f_font != blank
    assign out = out | append: '--' | append: v | append: '-font: ' | append: f_font | append: '; '
  endif
  if f_weight != blank
    assign out = out | append: '--' | append: v | append: '-weight: ' | append: f_weight | append: '; '
  endif
  if f_size != blank
    assign out = out | append: '--' | append: v | append: '-size: ' | append: f_size | append: '; '
  endif
  if f_size_m != blank
    assign out = out | append: '--' | append: v | append: '-size-m: ' | append: f_size_m | append: '; '
  endif
  if f_lh != blank
    assign out = out | append: '--' | append: v | append: '-lh: ' | append: f_lh | append: '; '
  endif
  if f_ls != blank
    assign out = out | append: '--' | append: v | append: '-ls: ' | append: f_ls | append: '; '
  endif
  if f_case != blank
    assign out = out | append: '--' | append: v | append: '-case: ' | append: f_case | append: '; '
  endif

  if has_settings
    assign colour_ids = 'color,hover_color,bg,hover_bg,border,hover_border' | split: ','
    for suffix in colour_ids
      case suffix
        when 'color'
          assign k = alias_color
          assign var_name = '-ink'
        when 'hover_color'
          assign k = alias_hover_color
          assign var_name = '-hover-ink'
        when 'bg'
          assign k = alias_bg
          assign var_name = '-bg'
        when 'hover_bg'
          assign k = alias_hover_bg
          assign var_name = '-hover-bg'
        when 'border'
          assign k = alias_border
          assign var_name = '-border'
        else
          assign k = alias_hover_border
          assign var_name = '-hover-border'
      endcase
      if k == blank
        assign k = p | append: '_' | append: suffix
      endif
      assign val = s[k]
      if val != blank
        assign out = out | append: '--' | append: v | append: var_name | append: ': ' | append: val | append: '; '
      endif
    endfor
  endif

  echo out | strip
-%}
