{% doc %}
  The newsletter signup form (bordered email field + accent Subscribe
  button), shared by the footer and the mobile nav drawer. Explicit form and
  input ids keep the two instances on one page valid and label-associated.

  @param {string} form_id - unique id for the <form>
  @param {string} input_id - unique id for the email input
  @example
  {% render 'newsletter-form', form_id: 'FooterNewsletter', input_id: 'NewsletterEmail' %}
{% enddoc %}

{% form 'customer', id: form_id, class: 'newsletter-form' %}
  <input type="hidden" name="contact[tags]" value="newsletter">
  {%- if form.posted_successfully? -%}
    <p class="newsletter-form__success" role="status">{{ 'general.newsletter.success' | t }}</p>
  {%- else -%}
    {{ form.errors | default_errors }}
    <div class="newsletter-form__row">
      <label class="visually-hidden" for="{{ input_id }}">{{ 'general.newsletter.email' | t }}</label>
      <input
        id="{{ input_id }}"
        class="field"
        type="email"
        name="contact[email]"
        value="{{ form.email }}"
        required
        autocomplete="email"
        placeholder="{{ 'general.newsletter.email' | t }}"
      >
      <button type="submit" class="button">{{ 'general.newsletter.submit' | t }}</button>
    </div>
  {%- endif -%}
{% endform %}
