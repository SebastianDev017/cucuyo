{% doc %}
  Resolves the collection that reads as a product's CATEGORY and renders it.

  `product.collections.first` is not usable directly: it can return Shopify's
  reserved `frontpage` bucket ("Home page"), which is a merchandising slot,
  not a category — it produced breadcrumbs like "SHOP > HOME PAGE" and card
  labels reading "HOME PAGE". This walks past frontpage (and the all-products
  catch-all) to the first real collection, and renders nothing when there
  isn't one, so nothing empty or misleading is ever printed.

  @param {product} product - the product to read the collection from
  @param {string} [as] - 'link' renders a separator + anchor for the
    breadcrumb; anything else renders the plain title
  @example
  {% render 'product-category', product: product, as: 'link' %}
  {% render 'product-category', product: product %}
{% enddoc %}

{%- liquid
  comment
    Prefer the collection that matches the product's Type. A product usually
    belongs to several collections (seasonal edits, sale, catch-alls), and
    `collections.first` returns whichever Shopify happens to order first —
    on this store that made every product read "Furniture". Type is the
    merchant's own category field and the category collections mirror it, so
    matching on it names the right one; the first real collection is only
    the fallback when nothing matches.
  endcomment
  assign category = null
  assign fallback = null

  for c in product.collections
    unless c.handle == 'frontpage' or c.handle == 'all'
      if fallback == null
        assign fallback = c
      endif
      if c.title == product.type
        assign category = c
        break
      endif
    endunless
  endfor

  assign category = category | default: fallback
-%}

{%- if category -%}
  {%- if as == 'link' -%}
    <span class="breadcrumb__separator" aria-hidden="true">&gt;</span>
    <a href="{{ category.url }}" class="breadcrumb__link">{{ category.title }}</a>
  {%- else -%}
    {{- category.title -}}
  {%- endif -%}
{%- endif -%}
