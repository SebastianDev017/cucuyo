{% doc %}
  Colour circles for a product whose options include Color.

  Built on Shopify's native option model, not a parallel one: the values come
  from `product.options_with_values`, the visual comes from
  `option_value.swatch` (what Shopify derives when the Color option is linked
  to the standard `shopify.color-pattern` metafield), and the target comes
  from `option_value.variant` — a REAL variant of the same product, never a
  sibling product. `snippets/color-palette` fills the visual in when a value
  has no linked metaobject yet, which is every value a CSV import creates.

  Each swatch is a link to that variant's URL, so it works with no JS at all:
  the click navigates and Shopify renders the page with the variant selected.
  theme.js upgrades it in place — price, image and URL update without a
  reload. Renders nothing unless there are 2+ colours to choose between.

  @param {product} product - the product to read options from
  @param {string} [context] - 'pdp' or 'card' (default), for sizing only
  @example
  {% render 'color-swatches', product: product, context: 'pdp' %}
{% enddoc %}

{%- liquid
  assign color_option = null
  for option in product.options_with_values
    assign option_name = option.name | downcase
    if option_name == 'color' or option_name == 'colour'
      assign color_option = option
      break
    endif
  endfor
-%}

{%- comment -%}
  ONE colour still renders. The threshold used to be "more than one", on the
  reasoning that a lone swatch offers no choice — but the real catalogue gives
  every product a single colour (Terracotta, Burgundy, White Ceramic), so that
  rule hid the swatch on every card in the shop. A single circle is not a
  control, it is the product's colour stated plainly, and the row of cards
  reads consistently because of it.
{%- endcomment -%}
{%- if color_option and color_option.values.size > 0 -%}
  <ul
    class="swatches swatches--{{ context | default: 'card' }}"
    role="list"
    data-swatches
    aria-label="{{ 'products.color_options' | t }}"
  >
    {%- for value in color_option.values -%}
      {%- liquid
        assign target = value.variant
        assign hex = ''
        assign is_current = value.selected
        if product.selected_or_first_available_variant.id == target.id
          assign is_current = true
        endif

        comment
          Three sources, most native first. 1) the option value's own swatch,
          which is what Shopify derives once the Color option is linked to the
          standard shopify.color-pattern metafield. 2) the product-level
          shopify.color-pattern entries, matched by label — a CSV can fill
          those in without linking the option. 3) the shared theme palette.
        endcomment
        if value.swatch.color != blank
          assign hex = value.swatch.color | color_to_hex
        endif

        if hex == blank
          for entry in product.metafields.shopify['color-pattern'].value
            assign entry_label = entry.label | default: entry.system.handle | downcase | replace: '-', ' '
            assign value_label = value.name | downcase
            if entry_label == value_label and entry.color.value.first != blank
              assign hex = entry.color.value.first | color_to_hex
              break
            endif
          endfor
        endif

        if hex == blank
          capture hex
            render 'color-palette', name: value.name
          endcapture
          assign hex = hex | strip
        endif

        comment
          Compound names. The real catalogue uses values like "White Ceramic"
          and "Antique Brass" — a colour plus the material or a qualifier —
          which no palette of plain colour names can match whole. So each word
          is tried in turn and the first that resolves wins, which handles
          whatever wording the merchant invents next without listing it here.
          Falling through to the value's name as text would break the row of
          circles on a card.
        endcomment
        if hex == blank
          assign name_words = value.name | split: ' '
          for word in name_words
            capture word_hex
              render 'color-palette', name: word
            endcapture
            assign word_hex = word_hex | strip
            if word_hex != blank
              assign hex = word_hex
              break
            endif
          endfor
        endif

        assign swatch_image = value.swatch.image
        assign variant_image = target.featured_media | default: target.image
      -%}
      <li>
        <a
          class="swatch{% unless value.available %} swatch--unavailable{% endunless %}"
          href="{{ target.url }}"
          data-swatch
          data-variant-id="{{ target.id }}"
          data-variant-option="{{ value.name | escape }}"
          {%- comment -%}
            Position and value are what let the product page's engine treat a
            swatch as one control among several: picking a colour has to keep
            the size already chosen. Harmless on a card, where the engine
            never runs.
          {%- endcomment -%}
          data-option-position="{{ color_option.position }}"
          data-option-value="{{ value.name | escape }}"
          data-variant-available="{{ target.available }}"
          data-variant-price="{{ target.price | money | escape }}"
          {% if target.compare_at_price > target.price %}
            data-variant-compare="{{ target.compare_at_price | money | escape }}"
          {% endif %}
          {% if variant_image %}
            data-variant-image="{{ variant_image | image_url: width: 1500 }}"
            data-variant-image-alt="{{ variant_image.alt | escape }}"
          {% endif %}
          {% if is_current %}
            aria-current="true"
          {% endif %}
          style="
            {%- if swatch_image -%}
              --swatch-image: url({{ swatch_image | image_url: width: 80 }});
            {%- elsif hex != blank -%}
              --swatch-color: {{ hex }};
            {%- endif -%}
          "
        >
          <span class="visually-hidden">{{ value.name }}</span>
          {%- if swatch_image == nil and hex == blank -%}
            <span class="swatch__name" aria-hidden="true">{{ value.name }}</span>
          {%- endif -%}
        </a>
      </li>
    {%- endfor -%}
  </ul>
{%- endif -%}
