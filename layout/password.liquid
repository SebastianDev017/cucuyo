<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_background }}">
    <link rel="canonical" href="{{ canonical_url }}">

    <title>{{ shop.name }}</title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {%- comment -%}
      The tokens and the @font-face rules both live in css-variables, the same
      snippet theme.liquid renders. This layout used to inline its own :root
      block naming ten settings that the Figma reset removed (type_display_font,
      color_surface, page_width and the rest), so every one of them resolved to
      nothing: the password page has been rendering with no brand fonts and no
      colours since. Rendering the real snippet is the whole fix.
    {%- endcomment -%}
    {% render 'css-variables' %}

    {{ 'base.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}
  </head>

  <body class="template-password">
    <main id="MainContent" class="password-main" role="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
