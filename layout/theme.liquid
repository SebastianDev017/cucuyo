<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <script>
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');
    </script>

    {% render 'meta-tags' %}
    {% render 'css-variables' %}

    {%- comment -%}
      Always emit a favicon so the browser never 404s on /favicon.ico
      (Atelier pattern): merchant favicon when set, inline SVG mark otherwise.
    {%- endcomment -%}
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- else -%}
      <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ccircle cx='50' cy='50' r='40' fill='%23623827'/%3E%3C/svg%3E">
    {%- endif -%}

    {{ 'base.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}
  </head>

  <body
    class="template-{{ request.page_type | handle }}"
    data-scroll-animations="{{ settings.enable_scroll_animations }}"
    data-smooth-scroll="{{ settings.enable_smooth_scroll }}"
  >
    <a class="skip-link" href="#main-content">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="main-content" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    {%- comment -%}
      GSAP 3.13 motion stack — self-hosted, never CDN. Deferred scripts execute
      in order, so gsap-init runs after the libraries are defined. All motion
      is fully gated behind prefers-reduced-motion inside gsap-animations.js,
      and initial states are set by GSAP at init (no CSS pre-hiding), so
      content is always visible without JS or under reduced motion.
    {%- endcomment -%}
    <script src="{{ 'lenis.min.js' | asset_url }}" defer></script>
    <script src="{{ 'gsap.min.js' | asset_url }}" defer></script>
    <script src="{{ 'ScrollTrigger.min.js' | asset_url }}" defer></script>
    <script src="{{ 'gsap-init.js' | asset_url }}" defer></script>
    <script src="{{ 'gsap-animations.js' | asset_url }}" defer></script>
  </body>
</html>
