      "breakpoint": "(max-width: 749px)",
      "swap": false,
      "lh": "1",
      "ls": "0",
      "case": "uppercase",
      "case_label": "capitals",
      "info_size": "43.2px at 1440px wide (the header row, from 1200px)",
