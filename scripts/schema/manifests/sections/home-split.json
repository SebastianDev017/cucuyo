{
  "file": "sections/home-split.liquid",
  "schema": {
    "name": "Mixed band",
    "tag": "section",
    "max_blocks": 5,
    "settings": [
      {
        "ref": "setting",
        "type": "select",
        "id": "media_side",
        "label": "Photograph side",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ],
        "default": "left"
      },
      {
        "ref": "setting",
        "type": "checkbox",
        "id": "show_collection_label",
        "label": "Show the category under each card name",
        "default": false
      },
      {
        "ref": "setting",
        "type": "select",
        "id": "header_tone",
        "label": "Header text over this section",
        "options": [
          {
            "value": "light",
            "label": "Light, for a dark photograph"
          },
          {
            "value": "ink",
            "label": "Brown, for a pale photograph"
          }
        ],
        "default": "ink",
        "info": "Homepage and category pages: as the first section, it sets the header colour at the top of the page. Light only reads on a dark photograph."
      }
    ],
    "blocks": [
      {
        "type": "media",
        "name": "Photograph",
        "limit": 1,
        "settings": [
          {
            "ref": "setting",
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },
          {
            "ref": "setting",
            "type": "text",
            "id": "draft_asset",
            "label": "Draft asset filename",
            "info": "Theme asset shown while no image is selected (design draft)"
          },
          {
            "ref": "setting",
            "type": "text",
            "id": "alt_text",
            "label": "Alt text"
          },
          {
            "ref": "setting",
            "type": "text",
            "id": "heading",
            "label": "Overlay title"
          },
          {
            "ref": "setting",
            "type": "textarea",
            "id": "body",
            "label": "Overlay paragraph"
          },
          {
            "ref": "setting",
            "type": "text",
            "id": "cta_label",
            "label": "Overlay link label",
            "info": "Underlined, e.g. \"Shop kitchenware\". Uses the Link below."
          },
          {
            "ref": "setting",
            "type": "url",
            "id": "link",
            "label": "Link"
          },
          {
            "ref": "setting",
            "type": "select",
            "id": "tone",
            "label": "Overlay text tone",
            "options": [
              {
                "value": "light",
                "label": "Light"
              },
              {
                "value": "ink",
                "label": "Ink"
              }
            ],
            "default": "light",
            "info": "Pick by looking at the photograph — neither is safe by default."
          },
          {
            "ref": "setting",
            "type": "checkbox",
            "id": "scrim",
            "label": "Soften the photograph under the text",
            "default": false,
            "info": "A gradient behind the overlay, for photographs the type cannot be read on."
          }
        ]
      },
      {
        "type": "card",
        "name": "Card",
        "limit": 4,
        "settings": [
          {
            "ref": "setting",
            "type": "product",
            "id": "product",
            "label": "Product"
          },
          {
            "ref": "setting",
            "type": "image_picker",
            "id": "image",
            "label": "Image",
            "info": "Overrides the product's own photograph"
          },
          {
            "ref": "setting",
            "type": "text",
            "id": "image_url",
            "label": "Image URL"
          },
          {
            "ref": "setting",
            "type": "text",
            "id": "alt_text",
            "label": "Alt text"
          },
          {
            "ref": "setting",
            "type": "text",
            "id": "draft_asset",
            "label": "Draft asset filename",
            "info": "Theme asset shown while no product or image is set"
          },
          {
            "ref": "setting",
            "type": "textarea",
            "id": "label",
            "label": "Label",
            "info": "Defaults to the product's title"
          },
          {
            "ref": "setting",
            "type": "select",
            "id": "label_tone",
            "label": "Label tone",
            "options": [
              {
                "value": "dark",
                "label": "Dark"
              },
              {
                "value": "light",
                "label": "Light"
              }
            ],
            "default": "dark"
          },
          {
            "ref": "setting",
            "type": "color",
            "id": "label_hover_color",
            "label": "Label colour on hover",
            "info": "The name and the Cucuyo bug while the pointer is over this card (tablet and desktop). Empty leaves them as they are."
          },
          {
            "ref": "setting",
            "type": "url",
            "id": "link",
            "label": "Link",
            "info": "Defaults to the product's page"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Mixed band",
        "blocks": [
          {
            "type": "media"
          },
          {
            "type": "card"
          },
          {
            "type": "card"
          },
          {
            "type": "card"
          },
          {
            "type": "card"
          }
        ]
      }
    ]
  }
}
