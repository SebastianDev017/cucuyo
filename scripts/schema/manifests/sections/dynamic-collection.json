{
  "file": "sections/dynamic-collection.liquid",
  "schema": {
    "name": "Dynamic collection",
    "tag": "section",
    "settings": [
      {
        "ref": "setting",
        "type": "paragraph",
        "content": "Fills itself from a collection: its first products, in the collection's order. Products that belong to several collections can appear in more than one of these sections."
      },
      {
        "ref": "setting",
        "type": "collection",
        "id": "collection",
        "label": "Collection",
        "info": "Leave empty on a category page to use the page's own collection. Two sections on the same collection show the same products."
      },
      {
        "ref": "setting",
        "type": "range",
        "id": "products_to_show",
        "label": "Products to show",
        "min": 1,
        "max": 16,
        "step": 1,
        "default": 4
      },
      {
        "ref": "setting",
        "type": "header",
        "content": "Heading"
      },
      {
        "ref": "setting",
        "type": "text",
        "id": "eyebrow",
        "label": "Eyebrow",
        "info": "Small line above the heading"
      },
      {
        "ref": "setting",
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "info": "Leave empty for no heading"
      },
      {
        "ref": "setting",
        "type": "select",
        "id": "heading_align",
        "label": "Heading alignment",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Centre"
          }
        ],
        "default": "center"
      },
      {
        "ref": "setting",
        "type": "header",
        "content": "Layout"
      },
      {
        "ref": "setting",
        "type": "range",
        "id": "columns_desktop",
        "label": "Columns (desktop)",
        "min": 2,
        "max": 5,
        "step": 1,
        "default": 4
      },
      {
        "ref": "setting",
        "type": "select",
        "id": "columns_mobile",
        "label": "Columns (mobile)",
        "options": [
          {
            "value": "1",
            "label": "1"
          },
          {
            "value": "2",
            "label": "2"
          }
        ],
        "default": "2"
      },
      {
        "ref": "setting",
        "type": "checkbox",
        "id": "flush",
        "label": "Flush (no gap)",
        "default": false
      },
      {
        "ref": "setting",
        "type": "checkbox",
        "id": "carousel",
        "label": "Carousel",
        "default": false,
        "info": "One sliding row with an arrow at each end, over the photographs. Columns sets how many show at once; the arrows appear when there are more products than that."
      },
      {
        "ref": "setting",
        "type": "checkbox",
        "id": "carousel_loop",
        "label": "Loop the carousel",
        "default": false,
        "info": "Past the last card the arrow goes back to the first, and the other way round."
      },
      {
        "ref": "setting",
        "type": "header",
        "content": "Card names"
      },
      {
        "ref": "setting",
        "type": "select",
        "id": "label_tone",
        "label": "Label tone",
        "options": [
          {
            "value": "dark",
            "label": "Dark"
          },
          {
            "value": "light",
            "label": "Light"
          }
        ],
        "default": "dark"
      },
      {
        "ref": "setting",
        "type": "color",
        "id": "label_color",
        "label": "Label colour",
        "info": "Empty uses the tone above. Also colours the Cucuyo bug."
      },
      {
        "ref": "setting",
        "type": "color",
        "id": "label_hover_color",
        "label": "Label colour on hover",
        "info": "The name and the Cucuyo bug while the pointer is over a card (tablet and desktop). Empty leaves them as they are."
      },
      {
        "ref": "setting",
        "type": "header",
        "content": "Colour and spacing"
      },
      {
        "ref": "setting",
        "type": "color",
        "id": "background_color",
        "label": "Background",
        "info": "Empty uses the theme's"
      },
      {
        "ref": "setting",
        "type": "color",
        "id": "text_color",
        "label": "Text",
        "info": "Empty uses the theme's"
      },
      {
        "ref": "setting",
        "type": "range",
        "id": "padding_top",
        "label": "Padding top",
        "min": 0,
        "max": 160,
        "step": 4,
        "unit": "px",
        "default": 0
      },
      {
        "ref": "setting",
        "type": "range",
        "id": "padding_bottom",
        "label": "Padding bottom",
        "min": 0,
        "max": 160,
        "step": 4,
        "unit": "px",
        "default": 0
      },
      {
        "ref": "setting",
        "type": "select",
        "id": "header_tone",
        "label": "Header text over this section",
        "options": [
          {
            "value": "light",
            "label": "Light, for a dark photograph"
          },
          {
            "value": "ink",
            "label": "Brown, for a pale photograph"
          }
        ],
        "default": "ink",
        "info": "Homepage and category pages: as the first section, it sets the header colour at the top of the page. Light only reads on a dark photograph."
      }
    ],
    "presets": [
      {
        "name": "Dynamic collection"
      }
    ]
  }
}
