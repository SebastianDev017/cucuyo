{%- comment -%}
  Two-up band (Figma) — two full-bleed photographs side by side with a 6px
  gutter, each 4:5, and on each one either a small-caps label in the corner
  (e.g. "PETRA VASE") or the full overlay: category title, paragraph and an
  underlined link. Used three times down the homepage, including as the first
  section under the header. Stacks on mobile.

  A half with an overlay link is NOT wrapped in a link of its own: an anchor
  inside an anchor is invalid and browsers unnest it, which breaks both. The
  link in the overlay is then the one thing that is clickable, as designed.
{%- endcomment -%}

<section
  class="home-hero"
  data-header-tone="{{ section.settings.header_tone }}"
  style="--band-ratio: {{ section.settings.ratio }};"
>
  <div class="home-hero__grid">
    {%- for block in section.blocks -%}
      {%- liquid
        assign has_overlay = false
        if block.settings.heading != blank or block.settings.body != blank or block.settings.cta_label != blank
          assign has_overlay = true
        endif
        assign wrap_link = false
        if block.settings.link != blank and has_overlay == false
          assign wrap_link = true
        endif
      -%}
      <div class="home-hero__cell" {{ block.shopify_attributes }}>
        {%- if wrap_link -%}<a href="{{ block.settings.link }}" class="home-hero__link">{%- endif -%}
        {% render 'draft-image',
          image: block.settings.image,
          draft_asset: block.settings.draft_asset,
          img_class: 'home-hero__media',
          sizes: '(min-width: 750px) 50vw, 100vw',
          alt: block.settings.label,
          loading: 'eager'
        %}
        {%- if block.settings.label != blank -%}
          <span class="home-hero__label{% if block.settings.label_tone == 'light' %} home-hero__label--light{% endif %}">
            {{- block.settings.label | escape | newline_to_br -}}
          </span>
        {%- endif -%}
        {%- if wrap_link -%}</a>{%- endif -%}

        {% render 'media-overlay',
          heading: block.settings.heading,
          body: block.settings.body,
          cta_label: block.settings.cta_label,
          link: block.settings.link,
          tone: block.settings.label_tone,
          scrim: block.settings.scrim
        %}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Two-up band",
  "tag": "section",
  "max_blocks": 2,
  "settings": [
    {
      "type": "select",
      "id": "header_tone",
      "label": "Header ink over this section",
      "options": [
        {
          "value": "light",
          "label": "Light (over dark imagery)"
        },
        {
          "value": "ink",
          "label": "Ink (over pale imagery)"
        }
      ],
      "default": "light",
      "info": "Home only — the header has no background, so its colour follows the section passing under it"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Image shape",
      "options": [
        {
          "value": "4 / 5",
          "label": "Portrait 4:5"
        },
        {
          "value": "3 / 4",
          "label": "Taller 3:4"
        },
        {
          "value": "1 / 1",
          "label": "Square"
        }
      ],
      "default": "4 / 5"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "draft_asset",
          "label": "Draft asset filename",
          "info": "Theme asset shown while no image is selected (design draft)"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Overlay title",
          "info": "Set in caps, e.g. the category"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Overlay paragraph"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Overlay link label",
          "info": "Underlined, e.g. \"Shop kitchenware\". Uses the block's Link."
        },
        {
          "type": "textarea",
          "id": "label",
          "label": "Label",
          "info": "Small caps label in the corner. Leave empty when the overlay above is used."
        },
        {
          "type": "select",
          "id": "label_tone",
          "label": "Text tone over this image",
          "options": [
            {
              "value": "dark",
              "label": "Dark"
            },
            {
              "value": "light",
              "label": "Light"
            }
          ],
          "default": "light",
          "info": "Applies to the label AND the overlay. Pick by looking at the photograph."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "scrim",
          "label": "Soften the photograph under the text",
          "default": false,
          "info": "A gradient behind the overlay, for photographs the type cannot be read on."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Two-up band",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}
