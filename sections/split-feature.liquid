{%- comment -%}
  Split feature — half image, half cream text panel (kicker, heading, body,
  CTA), for brand story / craftsmanship / interior-design service moments.
  Image keeps the house 756:957 ratio; position flips left or right.
{%- endcomment -%}

<section class="split split--media-{{ section.settings.media_position }}">
  <div class="split__media">
    {% render 'draft-image',
      image: section.settings.image,
      draft_asset: section.settings.draft_asset,
      img_class: 'split__image',
      sizes: '(min-width: 750px) 50vw, 100vw',
      alt: section.settings.heading
    %}
  </div>
  <div class="split__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="split__eyebrow type-label">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="split__heading">{{ section.settings.heading | escape | newline_to_br }}</h2>
    {%- endif -%}
    {%- if section.settings.body != blank -%}
      <div class="split__body rte">{{ section.settings.body }}</div>
    {%- endif -%}
    {%- if section.settings.link_label != blank and section.settings.link != blank -%}
      <a href="{{ section.settings.link }}" class="button">{{ section.settings.link_label | escape }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Split feature",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "media_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "draft_asset",
      "label": "Draft asset filename",
      "info": "Theme asset shown while no image is selected (design draft)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our craft"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Made by hand,\nmeant to last"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Every piece is sourced from makers who work slowly and deliberately, favouring natural materials, honest texture, and the quiet imperfection of the handmade.</p>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Button label",
      "default": "Read our story"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Split feature"
    }
  ]
}
{% endschema %}
