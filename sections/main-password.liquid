{%- comment -%}
  Password page — the storefront's closed door: the palm photograph full
  bleed, and one card centred on it carrying the mark, the note and the
  address to write to. Measured off Jenn's comp (card 566×657 on a 1894px
  frame, 16px corners, #52351A under #E9E3E0), and every default here
  reproduces it, so an untouched section renders the comp exactly.

  THE CORNERS ARE THE ONE EXCEPTION TO ZERO RADIUS. The theme is square
  everywhere by rule; the comp rounds this card. The value is carried by
  --cp-radius, declared on this section's own element and read by exactly one
  rule (.password-page__card). Nothing outside this section can see it, and
  no other radius is introduced anywhere.

  THE FORM IS NOT OPTIONAL. Without a working storefront_password form the
  only person who can get in is the owner, through the admin — everyone Jenn
  gives the password to would be locked out. The comp has no field, so it
  sits behind a disclosure at the foot of the card: a real <details>, which
  means it opens with keyboard and pointer alike with no JS at all, and it
  opens ITSELF whenever the form comes back with errors, so a wrong password
  is never a dead end.
{%- endcomment -%}

{%- liquid
  assign bg_image = section.settings.background_image
  assign bg_url = section.settings.background_image_url | strip
  assign logo = section.settings.logo
  assign email = section.settings.email | strip
  assign scrim = section.settings.overlay_opacity | divided_by: 100.0
-%}

<section
  class="password-page"
  style="
    --cp-card: {{ section.settings.card_color }};
    --cp-ink: {{ section.settings.text_color }};
    --cp-radius: {{ section.settings.card_radius }}px;
    --cp-card-width: {{ section.settings.card_width }}px;
    --cp-card-padding: {{ section.settings.card_padding }}px;
    --cp-logo-width: {{ section.settings.logo_width }}px;
    --cp-scrim: {{ scrim }};
  "
>
  {%- comment -%}
    The photograph is the page's largest paint, so it loads eagerly and at
    high priority. An upload goes through the CDN and gets a real responsive
    ladder; the external URL and the bundled asset are flat files, which is
    why the upload is the good path.
  {%- endcomment -%}
  <div class="password-page__bg">
    {%- if bg_image != blank -%}
      {{
        bg_image
        | image_url: width: 3000
        | image_tag:
          class: 'password-page__bg-media',
          loading: 'eager',
          fetchpriority: 'high',
          sizes: '100vw',
          widths: '600, 900, 1200, 1600, 2000, 2400, 3000',
          alt: ''
      }}
    {%- elsif bg_url != blank -%}
      <img
        src="{{ bg_url }}"
        class="password-page__bg-media"
        alt=""
        loading="eager"
        fetchpriority="high"
        width="1520"
        height="1900"
      >
    {%- else -%}
      <img
        src="{{ 'password-palms.jpg' | asset_url }}"
        class="password-page__bg-media"
        alt=""
        loading="eager"
        fetchpriority="high"
        width="1520"
        height="1900"
      >
    {%- endif -%}
  </div>

  {%- if section.settings.overlay_opacity > 0 -%}
    <div class="password-page__scrim" aria-hidden="true"></div>
  {%- endif -%}

  <div class="password-page__card">
    <h1 class="password-page__mark">
      {%- if logo != blank -%}
        {{
          logo
          | image_url: width: 900
          | image_tag:
            class: 'password-page__logo',
            loading: 'eager',
            sizes: '(min-width: 750px) 300px, 60vw',
            widths: '300, 450, 600, 900',
            alt: shop.name
        }}
      {%- else -%}
        <img
          src="{{ 'password-logo.png' | asset_url }}"
          class="password-page__logo"
          alt="{{ shop.name | escape }}"
          loading="eager"
          width="900"
          height="710"
        >
      {%- endif -%}
    </h1>

    <div class="password-page__note">
      {%- if section.settings.heading != blank -%}
        <p class="password-page__heading">{{ section.settings.heading | escape }}</p>
      {%- endif -%}

      {%- if section.settings.message != blank -%}
        <div class="password-page__message rte">{{ section.settings.message }}</div>
      {%- endif -%}

      {%- if email != blank -%}
        <a class="password-page__email" href="mailto:{{ email | escape }}">{{ email | escape }}</a>
      {%- endif -%}
    </div>

    {%- form 'storefront_password' -%}
      <details class="password-page__entry" {% if form.errors %}open{% endif %}>
        <summary class="password-page__toggle">{{ 'general.password.toggle' | t }}</summary>

        {%- if form.errors -%}
          {%- comment -%}
            role=alert so a screen reader is told without having to go looking
            for it. The markup comes from default_errors, which is Shopify's
            own and always matches whatever it decides to return; the styling
            puts it in the card's ink rather than the browser's red.
          {%- endcomment -%}
          <div class="password-page__error" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="password-page__field">
          <label class="visually-hidden" for="Password-{{ section.id }}">
            {{- 'general.password.label' | t -}}
          </label>
          <input
            id="Password-{{ section.id }}"
            class="password-page__input"
            type="password"
            name="password"
            autocomplete="current-password"
            placeholder="{{ 'general.password.label' | t }}"
            {% if form.errors %}
              autofocus
              aria-invalid="true"
            {% endif %}
          >
          <button type="submit" class="password-page__submit">{{ 'general.password.submit' | t }}</button>
        </div>
      </details>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background photograph"
    },
    {
      "type": "text",
      "id": "background_image_url",
      "label": "Background URL",
      "info": "Used when nothing is uploaded. Uploads are sharper — they get resized per screen."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Darken the photograph",
      "min": 0,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 0,
      "info": "Raise this if a new photograph is pale enough to weaken the card against it."
    },
    {
      "type": "header",
      "content": "Mark"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 120,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 300
    },
    {
      "type": "header",
      "content": "Words"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Launching this fall. Stay tuned!"
    },
    {
      "type": "richtext",
      "id": "message",
      "label": "Message",
      "default": "<p>In the meantime, email for any questions.</p>",
      "info": "Replaces the message set under Online Store → Preferences."
    },
    {
      "type": "text",
      "id": "email",
      "label": "Contact email",
      "default": "nicole@cucuyohome.com",
      "info": "Shown as a link that opens the visitor's mail app."
    },
    {
      "type": "header",
      "content": "Card"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Card",
      "default": "#52351A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text and logo",
      "default": "#E9E3E0"
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Card width",
      "min": 360,
      "max": 720,
      "step": 20,
      "unit": "px",
      "default": 560
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 24,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 80,
      "info": "Eases in on small screens so the words never run to the card's edge."
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16,
      "info": "The one rounded corner in the theme, and it stays on this page only."
    }
  ]
}
{% endschema %}
