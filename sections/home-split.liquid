{%- comment -%}
  Mixed band (Figma) — one tall photograph beside a 2×2 of product cards, the
  whole thing full-bleed with the same 6px gutter as the rest of the
  homepage's mosaic. The photograph is half the width and twice the height of
  a card, so every tile in the band is the same 4:5 shape.

  The photograph can carry the overlay (title, paragraph, underlined link),
  and it can sit on either side, so two of these bands running down the page
  do not have to be identical.

  Below 990px the 2×2 becomes a row of two under the photograph, and on a
  phone everything stacks — a 352px card at four across would be 90px wide.
{%- endcomment -%}

{%- liquid
  assign media_block = blank
  for block in section.blocks
    if block.type == 'media'
      assign media_block = block
      break
    endif
  endfor
-%}

<section
  class="home-split home-split--{{ section.settings.media_side }}"
  data-header-tone="{{ section.settings.header_tone }}"
>
  <div class="home-split__grid">
    {%- if media_block != blank -%}
      {%- liquid
        assign has_overlay = false
        if media_block.settings.heading != blank or media_block.settings.body != blank or media_block.settings.cta_label != blank
          assign has_overlay = true
        endif
      -%}
      <div class="home-split__media" {{ media_block.shopify_attributes }}>
        {%- if media_block.settings.link != blank and has_overlay == false -%}
          <a href="{{ media_block.settings.link }}" class="home-split__media-link">
        {%- endif -%}

        {% render 'draft-image',
          image: media_block.settings.image,
          draft_asset: media_block.settings.draft_asset,
          img_class: 'home-split__image',
          sizes: '(min-width: 990px) 50vw, 100vw',
          alt: media_block.settings.alt_text,
          loading: 'lazy'
        %}

        {%- if media_block.settings.link != blank and has_overlay == false -%}</a>{%- endif -%}

        {% render 'media-overlay',
          heading: media_block.settings.heading,
          body: media_block.settings.body,
          cta_label: media_block.settings.cta_label,
          link: media_block.settings.link,
          tone: media_block.settings.tone,
          scrim: media_block.settings.scrim
        %}
      </div>
    {%- endif -%}

    {%- comment -%}
      The cards are cells of THIS grid, not a nested grid: that is what makes
      the photograph beside them exactly as tall as the two rows it spans,
      gutter included, instead of a few pixels off.
    {%- endcomment -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'card' -%}
        {% render 'featured-card',
          block: block,
          columns: 4,
          show_swatches: false,
          show_collection: section.settings.show_collection_label
        %}
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Mixed band",
  "tag": "section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "select",
      "id": "media_side",
      "label": "Photograph side",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "show_collection_label",
      "label": "Show the category under each card name",
      "default": false
    },
    {
      "type": "select",
      "id": "header_tone",
      "label": "Header ink over this section",
      "options": [
        {
          "value": "light",
          "label": "Light (over dark imagery)"
        },
        {
          "value": "ink",
          "label": "Ink (over pale imagery)"
        }
      ],
      "default": "ink",
      "info": "Home only — the header has no background over the first section"
    }
  ],
  "blocks": [
    {
      "type": "media",
      "name": "Photograph",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "draft_asset",
          "label": "Draft asset filename",
          "info": "Theme asset shown while no image is selected (design draft)"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt text"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Overlay title"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Overlay paragraph"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Overlay link label",
          "info": "Underlined, e.g. \"Shop kitchenware\". Uses the Link below."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "tone",
          "label": "Overlay text tone",
          "options": [
            {
              "value": "light",
              "label": "Light"
            },
            {
              "value": "ink",
              "label": "Ink"
            }
          ],
          "default": "light",
          "info": "Pick by looking at the photograph — neither is safe by default."
        },
        {
          "type": "checkbox",
          "id": "scrim",
          "label": "Soften the photograph under the text",
          "default": false,
          "info": "A gradient behind the overlay, for photographs the type cannot be read on."
        }
      ]
    },
    {
      "type": "card",
      "name": "Card",
      "limit": 4,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Overrides the product's own photograph"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Image URL"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt text"
        },
        {
          "type": "text",
          "id": "draft_asset",
          "label": "Draft asset filename",
          "info": "Theme asset shown while no product or image is set"
        },
        {
          "type": "textarea",
          "id": "label",
          "label": "Label",
          "info": "Defaults to the product's title"
        },
        {
          "type": "select",
          "id": "label_tone",
          "label": "Label tone",
          "options": [
            {
              "value": "dark",
              "label": "Dark"
            },
            {
              "value": "light",
              "label": "Light"
            }
          ],
          "default": "dark"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Defaults to the product's page"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mixed band",
      "blocks": [
        {
          "type": "media"
        },
        {
          "type": "card"
        },
        {
          "type": "card"
        },
        {
          "type": "card"
        },
        {
          "type": "card"
        }
      ]
    }
  ]
}
{% endschema %}
