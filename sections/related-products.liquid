{%- comment -%}
  "Pair it with" (Figma product pg) — reuses the Featured collection pattern
  exactly: same card grid, image + overlaid small-caps title, no price.
  Source: the product's first collection; when it has too few products the
  grid falls back to the all-products collection. Placeholders are NEVER
  rendered — with no real products to show, the section stays out entirely.
{%- endcomment -%}
{%- liquid
  assign limit = section.settings.products_to_show
  assign min_size = limit | plus: 1
  assign source = product.collections.first
  if source == blank or source.products.size < min_size
    assign source = collections.all
  endif
-%}

{%- capture related_cards -%}
  {%- assign shown = 0 -%}
  {%- for item in source.products -%}
    {%- unless item.id == product.id or item.available == false -%}
      {%- if shown < limit -%}
        {% render 'featured-card', card_product: item, show_collection: section.settings.show_collection_label %}
        {%- assign shown = shown | plus: 1 -%}
      {%- endif -%}
    {%- endunless -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if related_cards contains 'image-card' -%}
  <section class="related">
    {%- if section.settings.heading != blank -%}
      <h2 class="related__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="card-grid" style="--cols-desktop: {{ section.settings.columns }}; --cols-mobile: 1;">
      {{ related_cards }}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Related products",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pair it with"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_collection_label",
      "label": "Show collection label",
      "default": true,
      "info": "The product's collection under its name on each card"
    }
  ],
  "presets": [
    {
      "name": "Related products"
    }
  ]
}
{% endschema %}
