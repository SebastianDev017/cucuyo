{%- comment -%}
  Footer — Figma: circular lowercase mark on the left, three columns of
  lowercase links, newsletter (bordered email field + accent Subscribe button
  + microcopy note) on the right. Columns are menu-driven; until the menus
  exist in Admin, each column falls back to its draft labels (one per line)
  so the layout always matches the design.
{%- endcomment -%}

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__mark" aria-hidden="true">
      {%- if section.settings.mark_image -%}
        {{-
          section.settings.mark_image
          | image_url: width: 240
          | image_tag: widths: '120, 240', sizes: '96px', alt: ''
        -}}
      {%- else -%}
        <img src="{{ 'figma-footer-mark.png' | asset_url }}" width="162" height="145" alt="" loading="lazy">
      {%- endif -%}
    </div>

    <div class="site-footer__columns">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            {%- capture links_label -%}{{ 'sections.footer.links_label' | t }}{%- endcapture -%}
            {%- liquid
              if block.settings.heading != blank
                assign col_label = block.settings.heading
              else
                assign col_label = links_label | append: ' ' | append: forloop.index
              endif
            -%}
            <nav class="site-footer__col" aria-label="{{ col_label | strip }}" {{ block.shopify_attributes }}>
              <ul class="site-footer__links" role="list">
                {%- if block.settings.menu != blank -%}
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}" class="site-footer__link">{{ link.title }}</a></li>
                  {%- endfor -%}
                {%- else -%}
                  {%- assign fallback_lines = block.settings.fallback_links | newline_to_br | split: '<br />' -%}
                  {%- for line in fallback_lines -%}
                    {%- assign label = line | strip -%}
                    {%- if label != blank -%}
                      <li><a href="#" class="site-footer__link">{{ label }}</a></li>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              </ul>
            </nav>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.show_newsletter -%}
      <div class="site-footer__newsletter">
        {% render 'newsletter-form', form_id: 'FooterNewsletter', input_id: 'NewsletterEmail' %}
        {%- if section.settings.newsletter_note != blank -%}
          <p class="site-footer__note">{{ section.settings.newsletter_note }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "mark_image",
      "label": "Brand mark",
      "info": "The circular lowercase mark. Falls back to the draft asset when empty."
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_note",
      "label": "Newsletter note",
      "default": "Sign up to our newsletter to receive exclusive offers."
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Link column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Accessible name",
          "info": "Not displayed — names this column for screen readers"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        },
        {
          "type": "textarea",
          "id": "fallback_links",
          "label": "Draft labels",
          "info": "One label per line. Shown only while no menu is selected."
        }
      ]
    }
  ],
  "max_blocks": 4
}
{% endschema %}
