{%- comment -%}
  Footer, two layouts (Footer > Layout):
  - "columns" (Jen and Eugenia, 2026-10-06, after chloe.com): the CUCUYO logo
    on top, exactly as wide as the newsletter column under it; then the
    newsletter (title, line, email + Subscribe) on the left and the link
    columns with visible titles on the right; at the bottom the copyright on
    the left and an "Instagram" word link on the right. Links and copyright
    12px.
  - "split": the large logo on the left with the links and sign-up on the
    right (2026-10-05 version).
  Columns are menu-driven; until a menu is picked, each column falls back to
  its draft labels (one per line).
{%- endcomment -%}

{%- assign mark_width = section.settings.mark_width | default: 300 -%}
{%- liquid
  assign logo_style = section.settings.logo_style | default: 'image'
  assign layout = section.settings.footer_layout | default: 'split'
  assign brand_width = section.settings.brand_width | default: 790
  assign year = 'now' | date: '%Y'
-%}

{%- capture mark_html -%}
  <div class="site-footer__mark{% if logo_style == 'stacked' %} site-footer__mark--stacked{% endif %}" aria-hidden="true">
    {%- if logo_style == 'stacked' -%}
      <img src="{{ 'cucuyo-home-stacked.svg' | asset_url }}" width="123" height="122" alt="" loading="lazy">
    {%- elsif section.settings.mark_image -%}
      {%- case layout -%}
        {%- when 'split' -%}
          {%- capture mark_sizes -%}(min-width: 990px) min({{ brand_width }}px, 55vw), 100vw{%- endcapture -%}
        {%- else -%}
          {%- capture mark_sizes -%}(min-width: 1200px) 25vw, (min-width: 750px) 40vw, 60vw{%- endcapture -%}
      {%- endcase -%}
      {{-
        section.settings.mark_image
        | image_url: width: 1200
        | image_tag: widths: '300, 450, 600, 900, 1200', sizes: mark_sizes, alt: '', loading: 'lazy'
      -}}
    {%- else -%}
      <img src="{{ 'figma-footer-mark.png' | asset_url }}" width="162" height="145" alt="" loading="lazy">
    {%- endif -%}
  </div>
{%- endcapture -%}

{%- capture columns_html -%}
  <div class="site-footer__columns">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'menu' -%}
          {%- capture links_label -%}{{ 'sections.footer.links_label' | t }}{%- endcapture -%}
          {%- liquid
            if block.settings.heading != blank
              assign col_label = block.settings.heading
            else
              assign col_label = links_label | append: ' ' | append: forloop.index
            endif
          -%}
          <nav class="site-footer__col" aria-label="{{ col_label | strip }}" {{ block.shopify_attributes }}>
            {%- if layout == 'columns' and block.settings.heading != blank -%}
              <h2 class="site-footer__heading">{{ block.settings.heading | escape }}</h2>
            {%- endif -%}
            <ul class="site-footer__links" role="list">
              {%- if block.settings.menu != blank -%}
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}" class="site-footer__link">{{ link.title }}</a></li>
                {%- endfor -%}
              {%- else -%}
                {%- assign fallback_lines = block.settings.fallback_links | newline_to_br | split: '<br />' -%}
                {%- for line in fallback_lines -%}
                  {%- assign label = line | strip -%}
                  {%- if label != blank -%}
                    <li><a href="#" class="site-footer__link">{{ label }}</a></li>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            </ul>
          </nav>
      {%- endcase -%}
    {%- endfor -%}
  </div>
{%- endcapture -%}

{%- capture copyright_html -%}
  {%- if section.settings.copyright != blank -%}
    <p class="site-footer__copyright">&copy;{{ section.settings.copyright | escape }} {{ year }}</p>
  {%- endif -%}
{%- endcapture -%}

<footer class="site-footer site-footer--{{ layout }}" style="--footer-mark-width: {{ mark_width }}px; --footer-brand-width: {{ brand_width }}px; --footer-stacked-width: {{ section.settings.stacked_width | default: 116 }}px; --footer-stacked-width-m: {{ section.settings.stacked_width_mobile | default: 140 }}px;">
  <div class="site-footer__inner">
    {%- if layout == 'columns' -%}
      <div class="site-footer__brand">{{ mark_html }}</div>
      {%- if section.settings.show_newsletter -%}
        <div class="site-footer__newsletter">
          {%- if section.settings.newsletter_heading != blank -%}
            <h2 class="site-footer__newsletter-heading">{{ section.settings.newsletter_heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.newsletter_note != blank -%}
            <p class="site-footer__intro">{{ section.settings.newsletter_note }}</p>
          {%- endif -%}
          {% render 'newsletter-form', form_id: 'FooterNewsletter', input_id: 'NewsletterEmail' %}
        </div>
      {%- endif -%}
      {{ columns_html }}
      <div class="site-footer__bottom">
        {{ copyright_html }}
        {%- if section.settings.instagram_url != blank -%}
          <a href="{{ section.settings.instagram_url }}" class="site-footer__social" target="_blank" rel="noopener">
            {{- section.settings.instagram_label | default: 'Instagram' | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- else -%}
      <div class="site-footer__brand">
        {{ mark_html }}
        {{ copyright_html }}
      </div>
      {{ columns_html }}
      {%- if section.settings.show_newsletter -%}
        <div class="site-footer__newsletter">
          {% render 'newsletter-form', form_id: 'FooterNewsletter', input_id: 'NewsletterEmail' %}
          {%- if section.settings.show_newsletter_note and section.settings.newsletter_note != blank -%}
            <p class="site-footer__note">{{ section.settings.newsletter_note }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    {
      "type": "select",
      "id": "footer_layout",
      "label": "Layout",
      "options": [
        { "value": "split", "label": "Large logo left, links and sign-up right" },
        { "value": "columns", "label": "Logo on top, newsletter and link columns (classic)" }
      ],
      "default": "split"
    },
    {
      "type": "select",
      "id": "logo_style",
      "label": "Logo",
      "options": [
        { "value": "image", "label": "Uploaded image (CUCUYO brush logo)" },
        { "value": "stacked", "label": "Cucuyo Home stacked logo" }
      ],
      "default": "image"
    },
    {
      "type": "range",
      "id": "brand_width",
      "label": "Logo width",
      "min": 300,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 790,
      "info": "Large-logo layout. Phones use the full width.",
      "visible_if": "{{ section.settings.footer_layout == 'split' and section.settings.logo_style == 'image' }}"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright line",
      "default": "CUCUYO HOME",
      "info": "Shown as ©TEXT and the current year, under the logo. Empty hides it."
    },
    {
      "type": "range",
      "id": "stacked_width",
      "label": "Stacked logo width",
      "min": 60,
      "max": 240,
      "step": 2,
      "unit": "px",
      "default": 116,
      "visible_if": "{{ section.settings.logo_style == 'stacked' }}"
    },
    {
      "type": "range",
      "id": "stacked_width_mobile",
      "label": "Stacked logo width on phones",
      "min": 60,
      "max": 300,
      "step": 4,
      "unit": "px",
      "default": 140,
      "visible_if": "{{ section.settings.logo_style == 'stacked' }}"
    },
    {
      "type": "image_picker",
      "id": "mark_image",
      "label": "Brand mark",
      "info": "Falls back to the draft asset when empty."
    },
    {
      "type": "range",
      "id": "mark_width",
      "label": "Logo width (three-column layout)",
      "min": 80,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 300,
      "info": "On desktop. Phones cap it at about two thirds of the screen."
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter title",
      "default": "Newsletter",
      "info": "Classic layout: shown above the sign-up line."
    },
    {
      "type": "checkbox",
      "id": "show_newsletter_note",
      "label": "Show the note under the sign-up",
      "default": false
    },
    {
      "type": "text",
      "id": "newsletter_note",
      "label": "Newsletter note",
      "info": "Classic layout: the line above the email field. Large-logo layout: the note under the button (when shown).",
      "default": "Sign up to our newsletter to receive exclusive offers."
    },
    {
      "type": "header",
      "content": "Instagram"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram link",
      "info": "Classic layout: shows the word below at the bottom right."
    },
    {
      "type": "text",
      "id": "instagram_label",
      "label": "Link text",
      "default": "Instagram"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Link column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Accessible name",
          "info": "Not displayed — names this column for screen readers"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        },
        {
          "type": "textarea",
          "id": "fallback_links",
          "label": "Draft labels",
          "info": "One label per line. Shown only while no menu is selected."
        }
      ]
    }
  ],
  "max_blocks": 4
}
{% endschema %}

{% stylesheet %}
  .site-footer__mark.site-footer__mark--stacked {
    width: var(--footer-stacked-width, 116px);
  }

  .site-footer__mark--stacked img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 749px) {
    .site-footer__mark.site-footer__mark--stacked {
      width: var(--footer-stacked-width-m, 140px);
    }
  }

  /* Large-logo layout (Eugenia, 2026-10-05), measured on her frame at 1440:
     the brush logo ≈790px on the left with the copyright 12px under it; on
     the right a 384px column: two link columns (5:3, 16px brown, 29px lines)
     and, 24px under them, the email field and the button stacked (44px each,
     4px apart, words 13px in). Links and logo share the same top. */
  .site-footer.site-footer--split {
    padding-top: 64px;
  }

  .site-footer.site-footer--split .site-footer__inner {
    grid-template-columns: minmax(0, 1fr) minmax(0, 384px);
    grid-template-areas: 'brand links' 'brand form';
    grid-template-rows: auto 1fr;
    column-gap: 64px;
    row-gap: 24px;
    align-items: start;
  }

  .site-footer.site-footer--split .site-footer__brand {
    grid-area: brand;
  }

  .site-footer.site-footer--split .site-footer__mark:not(.site-footer__mark--stacked) {
    width: min(var(--footer-brand-width, 790px), 100%);
  }

  .site-footer__copyright {
    margin: 12px 0 0 6px;
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight, 500);
    font-size: 0.6875rem;
    letter-spacing: 0;
    line-height: 1.3;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .site-footer.site-footer--split .site-footer__columns {
    grid-area: links;
    grid-template-columns: minmax(0, 5fr) minmax(0, 3fr);
    column-gap: 0;
    row-gap: 0;
    width: 100%;
  }

  .site-footer.site-footer--split .site-footer__link {
    font-size: calc(1.111rem * var(--body-scale, 1));
    line-height: 1.8;
    letter-spacing: 0;
    color: var(--color-accent);
  }

  .site-footer.site-footer--split .site-footer__newsletter {
    grid-area: form;
    justify-self: stretch;
    width: 100%;
  }

  .site-footer.site-footer--split .newsletter-form__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 4px;
  }

  .site-footer.site-footer--split .newsletter-form__row .field,
  .site-footer.site-footer--split .newsletter-form__row .button {
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    height: 44px;
    padding: 0 13px;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 400;
    text-align: left;
  }

  .site-footer.site-footer--split .newsletter-form__row .field {
    border: 1px solid var(--color-accent);
    background: #fff;
    color: var(--color-accent);
  }

  .site-footer.site-footer--split .newsletter-form__row .field::placeholder {
    color: var(--color-accent);
    opacity: 1;
  }

  .site-footer.site-footer--split .newsletter-form__row .button {
    height: 45px;
    border: none;
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  @media (min-width: 1200px) {
    .site-footer.site-footer--split {
      padding-inline: max(var(--page-margin), 64px);
    }
  }

  /* Below 990px the two halves stack: logo and copyright, links, sign-up. */
  @media (max-width: 989px) {
    .site-footer.site-footer--split .site-footer__inner {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'brand' 'links' 'form';
      grid-template-rows: auto;
      row-gap: 32px;
    }

    .site-footer.site-footer--split .site-footer__newsletter {
      max-width: 480px;
    }
  }

  @media (max-width: 749px) {
    .site-footer.site-footer--split {
      padding-top: 56px;
    }

    .site-footer.site-footer--split .site-footer__columns {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  /* Classic layout (Jen and Eugenia, 2026-10-06, after chloe.com), at 1440:
     the logo on top, as wide as the newsletter column under it (a quarter of
     the content width); 80px down, the newsletter column on the left and the
     link columns from a third of the way across; 96px down, the copyright left
     and the Instagram word right. Links, titles and copyright 12px. */
  .site-footer.site-footer--columns {
    padding: 64px var(--page-margin) 40px;
  }

  .site-footer.site-footer--columns .site-footer__inner {
    grid-template-columns: minmax(0, 25fr) minmax(0, 9fr) minmax(0, 66fr);
    grid-template-areas: 'brand . .' 'news . links' 'bottom bottom bottom';
    gap: 0;
    align-items: start;
  }

  .site-footer.site-footer--columns .site-footer__brand {
    grid-area: brand;
    margin-bottom: 80px;
  }

  .site-footer.site-footer--columns .site-footer__mark:not(.site-footer__mark--stacked) {
    width: 100%;
  }

  .site-footer.site-footer--columns .site-footer__newsletter {
    grid-area: news;
    justify-self: stretch;
    width: 100%;
  }

  .site-footer__newsletter-heading {
    margin: 0 0 8px;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .site-footer__intro {
    margin: 0 0 16px;
    font-family: var(--font-body);
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--color-accent);
  }

  .site-footer.site-footer--columns .newsletter-form__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0;
  }

  .site-footer.site-footer--columns .newsletter-form__row .field,
  .site-footer.site-footer--columns .newsletter-form__row .button {
    box-sizing: border-box;
    min-width: 0;
    height: 46px;
    padding: 0 16px;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 400;
  }

  .site-footer.site-footer--columns .newsletter-form__row .field {
    border: 1px solid var(--color-accent);
    border-inline-end: none;
    background: #fff;
    color: var(--color-accent);
  }

  .site-footer.site-footer--columns .newsletter-form__row .field::placeholder {
    color: var(--color-accent);
    opacity: 1;
  }

  .site-footer.site-footer--columns .newsletter-form__row .button {
    border: 1px solid var(--color-accent);
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .site-footer.site-footer--columns .site-footer__columns {
    grid-area: links;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: 24px;
    row-gap: 32px;
    width: 100%;
  }

  .site-footer__heading {
    margin: 0 0 10px;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.75rem;
    line-height: 1.4;
    letter-spacing: 0;
    color: var(--color-accent);
  }

  .site-footer.site-footer--columns .site-footer__link {
    font-size: 0.75rem;
    line-height: 1.85;
    letter-spacing: 0;
    color: var(--color-accent);
  }

  .site-footer.site-footer--columns .site-footer__bottom {
    grid-area: bottom;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px 24px;
    margin-top: 96px;
  }

  .site-footer.site-footer--columns .site-footer__copyright {
    margin: 0;
    font-size: 0.75rem;
  }

  .site-footer__social {
    font-family: var(--font-body);
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 1199.98px) {
    .site-footer.site-footer--columns .site-footer__inner {
      grid-template-columns: minmax(0, 40fr) minmax(0, 6fr) minmax(0, 54fr);
    }

    .site-footer.site-footer--columns .site-footer__columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 749px) {
    .site-footer.site-footer--columns {
      padding: 48px var(--page-margin) 32px;
    }

    .site-footer.site-footer--columns .site-footer__inner {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'brand' 'news' 'links' 'bottom';
    }

    .site-footer.site-footer--columns .site-footer__brand {
      width: 60%;
      margin-bottom: 40px;
    }

    .site-footer.site-footer--columns .site-footer__columns {
      margin-top: 40px;
    }

    .site-footer.site-footer--columns .site-footer__bottom {
      margin-top: 48px;
    }
  }
{% endstylesheet %}
