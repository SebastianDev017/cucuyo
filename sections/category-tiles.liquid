{%- comment -%}
  Category tiles — shop-by-category or shop-by-room row. Unlike the featured
  grids (labels overlaid), tiles carry their small-caps label BELOW a square
  image, giving the home a quieter, catalogue-like rhythm. Each tile links to
  a collection (image and label fall back to it) or uses a picked image.
{%- endcomment -%}

<section class="tiles">
  {%- if section.settings.heading != blank -%}
    <h2 class="tiles__heading type-label">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  <ul
    class="tiles__grid"
    role="list"
    style="--cols-desktop: {{ section.settings.columns_desktop | default: 4 }}; --cols-mobile: 2;"
  >
    {%- for block in section.blocks -%}
      {%- liquid
        assign tile_collection = block.settings.collection
        assign tile_label = block.settings.label
        assign tile_url = block.settings.link
        if tile_collection and tile_label == blank
          assign tile_label = tile_collection.title
        endif
        if tile_collection and tile_url == blank
          assign tile_url = tile_collection.url
        endif
      -%}
      <li {{ block.shopify_attributes }}>
        {%- if tile_url != blank -%}<a href="{{ tile_url }}" class="tiles__item">{%- else -%}<div class="tiles__item">{%- endif -%}
        {%- if block.settings.image == blank and tile_collection.featured_image -%}
          {{-
            tile_collection.featured_image
            | image_url: width: 900
            | image_tag: widths: '400, 600, 900', sizes: '(min-width: 750px) 25vw, 50vw', class: 'tiles__image', alt: tile_label, loading: 'lazy'
          -}}
        {%- else -%}
          {% render 'draft-image',
            image: block.settings.image,
            draft_asset: block.settings.draft_asset,
            img_class: 'tiles__image',
            sizes: '(min-width: 750px) 25vw, 50vw',
            alt: tile_label,
            asset_width: 756,
            asset_height: 756
          %}
        {%- endif -%}
        {%- if tile_label != blank -%}
          <span class="tiles__label type-label">{{ tile_label | escape }}</span>
        {%- endif -%}
        {%- if tile_url != blank -%}</a>{%- else -%}</div>{%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "Category tiles",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    }
  ],
  "max_blocks": 10,
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Supplies the image, label, and link when set"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Overrides the collection image"
        },
        {
          "type": "text",
          "id": "draft_asset",
          "label": "Draft asset filename"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "info": "Falls back to the collection title"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Overrides the collection link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category tiles",
      "blocks": [
        { "type": "tile", "settings": { "label": "Tableware" } },
        { "type": "tile", "settings": { "label": "Lighting" } },
        { "type": "tile", "settings": { "label": "Storage" } },
        { "type": "tile", "settings": { "label": "Linens" } }
      ]
    }
  ]
}
{% endschema %}
