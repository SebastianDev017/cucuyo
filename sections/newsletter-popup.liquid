{%- comment -%}
  Newsletter pop-up (Jen, 2026-10-08): opens a few seconds after a visitor
  lands (3 by default), once per visit. After it is closed it stays away for
  the number of days set below; after a sign-up it stays away for a year.
  Customers already subscribed never see it. Rendered statically from
  layout/theme.liquid, so it is on every page and edited from any of them in
  the theme editor, where it opens while the section is selected instead of
  on a timer.

  Layout measured on Jen's mock (a 440 x 600 card): every size is a share of
  the card's width (cqw), so phones get the same composition, smaller.
{%- endcomment -%}

{%- liquid
  assign subscribed = false
  if customer and customer.accepts_marketing
    assign subscribed = true
  endif
-%}

{%- if request.design_mode or section.settings.enabled and subscribed == false -%}
  <dialog
    id="NewsletterPopup"
    class="newsletter-popup"
    aria-labelledby="NewsletterPopupTitle"
    data-section="{{ section.id }}"
    data-enabled="{{ section.settings.enabled }}"
    data-delay="{{ section.settings.delay }}"
    data-days="{{ section.settings.days }}"
    style="--popup-bg: {{ section.settings.color_background }}; --popup-ink: {{ section.settings.color_text }}; --popup-detail: {{ section.settings.color_detail }};"
  >
    <div class="newsletter-popup__card">
      <button type="button" class="newsletter-popup__close" data-popup-close>
        <span class="visually-hidden">{{ 'accessibility.close' | t }}</span>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
          <path d="M2 2l12 12M14 2L2 14" stroke="currentColor" stroke-width="1"/>
        </svg>
      </button>

      {%- if section.settings.show_icon -%}
        <span class="newsletter-popup__icon" aria-hidden="true"></span>
      {%- endif -%}

      <h2 id="NewsletterPopupTitle" class="newsletter-popup__heading">{{ section.settings.heading | escape }}</h2>

      {%- if section.settings.text != blank -%}
        <div class="newsletter-popup__text">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- form 'customer', id: 'NewsletterPopupForm', class: 'newsletter-popup__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter, popup">
        {%- if form.posted_successfully? -%}
          <div class="newsletter-popup__done" role="status" data-popup-posted="success">
            {{ section.settings.success_text }}
            {%- if section.settings.discount_code != blank -%}
              <p class="newsletter-popup__code">{{ section.settings.discount_code | escape }}</p>
            {%- endif -%}
          </div>
        {%- else -%}
          {%- if form.errors -%}
            <div class="newsletter-popup__error" data-popup-posted="error">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <div class="newsletter-popup__row">
            <label class="visually-hidden" for="NewsletterPopupEmail">{{ 'general.newsletter.email' | t }}</label>
            <input
              id="NewsletterPopupEmail"
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              required
              autocomplete="email"
              placeholder="{{ section.settings.placeholder | escape }}"
            >
            <button type="submit">{{ section.settings.button_label | escape }}</button>
          </div>
        {%- endif -%}
      {%- endform -%}

      {%- if section.settings.footnote != blank -%}
        <p class="newsletter-popup__footnote">{{ section.settings.footnote | escape }}</p>
      {%- endif -%}
    </div>
  </dialog>

  <script>
    (function () {
      var KEY = 'cucuyo-popup';
      var dialog = function () { return document.getElementById('NewsletterPopup'); };
      var d = dialog();
      if (!d || typeof d.showModal !== 'function') return;
      var design = !!(window.Shopify && window.Shopify.designMode);

      var store = function (area, key, value) {
        try {
          if (value === undefined) return window[area].getItem(key);
          if (value === null) window[area].removeItem(key);
          else window[area].setItem(key, value);
        } catch (e) {}
        return null;
      };
      var lock = function (on) {
        document.documentElement.classList.toggle('newsletter-popup-open', on);
        if (window.lenis) {
          if (on) window.lenis.stop();
          else window.lenis.start();
        }
      };
      var open = function () {
        var el = dialog();
        if (!el || el.open) return;
        el.showModal();
        lock(true);
        store('sessionStorage', KEY, '1');
        var close = el.querySelector('[data-popup-close]');
        if (close) close.focus();
      };
      var close = function () {
        var el = dialog();
        if (el && el.open) el.close();
      };

      d.addEventListener('close', function () {
        lock(false);
        /* closed: away for the chosen days (0 = until the next visit) */
        var days = parseFloat(d.dataset.days) || 0;
        var until = Date.now() + days * 864e5;
        if (!design && days > 0 && until > (parseFloat(store('localStorage', KEY + '-until')) || 0)) {
          store('localStorage', KEY + '-until', String(until));
        }
      });
      d.addEventListener('click', function (e) {
        if (e.target === d) close(); /* the backdrop */
      });
      d.querySelectorAll('[data-popup-close]').forEach(function (btn) {
        btn.addEventListener('click', close);
      });
      var form = d.querySelector('form');
      if (form) form.addEventListener('submit', function () { store('sessionStorage', KEY + '-sent', '1'); });

      if (design) {
        if (store('sessionStorage', KEY + '-editing') === '1') open();
        if (!window.__cucuyoPopupEditor) {
          window.__cucuyoPopupEditor = true;
          document.addEventListener('shopify:section:select', function (e) {
            var el = dialog();
            if (el && e.detail.sectionId === el.dataset.section) {
              store('sessionStorage', KEY + '-editing', '1');
              open();
            }
          });
          document.addEventListener('shopify:section:deselect', function (e) {
            var el = dialog();
            if (el && e.detail.sectionId === el.dataset.section) {
              store('sessionStorage', KEY + '-editing', null);
              close();
            }
          });
        }
        return;
      }

      /* back from a sign-up made in the pop-up: show how it went */
      var posted = d.querySelector('[data-popup-posted]');
      if (posted && store('sessionStorage', KEY + '-sent') === '1') {
        store('sessionStorage', KEY + '-sent', null);
        if (posted.dataset.popupPosted === 'success') {
          store('localStorage', KEY + '-until', String(Date.now() + 365 * 864e5));
        }
        open();
        return;
      }
      /* signed up anywhere else on the site (footer, menu): no pop-up */
      if (posted && posted.dataset.popupPosted === 'success') {
        store('localStorage', KEY + '-until', String(Date.now() + 365 * 864e5));
        return;
      }

      if (d.dataset.enabled !== 'true') return;
      if (store('sessionStorage', KEY) === '1') return;
      var until = parseFloat(store('localStorage', KEY + '-until')) || 0;
      if (until > Date.now()) return;
      window.setTimeout(open, (parseFloat(d.dataset.delay) || 0) * 1000);
    })();
  </script>
{%- endif -%}

{% stylesheet %}
  .newsletter-popup {
    container-type: inline-size;
    width: min(440px, calc(100vw - 32px));
    max-width: none;
    max-height: calc(100svh - 32px);
    margin: auto;
    padding: 0;
    border: 0;
    background: var(--popup-bg, #5d3f1f);
    color: var(--popup-ink, #fff);
    overflow-x: hidden;
    overflow-y: auto;
  }

  .newsletter-popup::backdrop {
    background: rgba(28, 18, 8, 0.45);
  }

  .newsletter-popup[open] {
    animation: newsletter-popup-in 0.35s ease-out;
  }

  @keyframes newsletter-popup-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .newsletter-popup[open] {
      animation: none;
    }
  }

  html.newsletter-popup-open,
  html.newsletter-popup-open body {
    overflow: hidden;
  }

  .newsletter-popup__card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 136.4cqw;
    padding: 31.8cqw 6cqw 4.5cqw;
    text-align: center;
  }

  .newsletter-popup__close {
    position: absolute;
    top: 8px;
    right: 8px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .newsletter-popup__icon {
    display: block;
    width: 7.7cqw;
    aspect-ratio: 140.53 / 266.94;
    background: currentColor;
    -webkit-mask: var(--cucuyo-bug) center / contain no-repeat;
    mask: var(--cucuyo-bug) center / contain no-repeat;
  }

  .newsletter-popup__heading {
    margin: 8.2cqw 0 0;
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight, 500);
    font-size: 14.8cqw;
    line-height: 1;
    letter-spacing: 0;
    text-transform: uppercase;
    color: inherit;
  }

  .newsletter-popup__text {
    max-width: 72cqw;
    margin-top: 2.5cqw;
    font-family: var(--font-body);
    font-weight: 300;
    font-size: max(12px, 3.1cqw);
    line-height: 1.6;
  }

  .newsletter-popup__text p,
  .newsletter-popup__done p {
    margin: 0;
  }

  .newsletter-popup__form {
    width: 76cqw;
    margin-top: 11.6cqw;
  }

  .newsletter-popup__row {
    display: flex;
    align-items: baseline;
    gap: 12px;
    border-bottom: 1px solid var(--popup-detail, #8c6d3a);
  }

  .newsletter-popup__row input {
    flex: 1;
    min-width: 0;
    padding: 8px 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    font-family: var(--font-body);
    font-size: max(12px, 2.8cqw);
    color: inherit;
  }

  .newsletter-popup__row input::placeholder {
    color: var(--popup-detail, #8c6d3a);
    opacity: 1;
  }

  .newsletter-popup__row input:focus {
    outline: none;
  }

  .newsletter-popup__row:focus-within {
    border-bottom-color: currentColor;
  }

  .newsletter-popup__row button {
    padding: 8px 0;
    border: 0;
    background: none;
    font-family: var(--font-body);
    font-size: max(12px, 2.8cqw);
    color: inherit;
    cursor: pointer;
  }

  .newsletter-popup__done,
  .newsletter-popup__error {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: max(12px, 3.1cqw);
    line-height: 1.6;
  }

  .newsletter-popup__error {
    margin-bottom: 8px;
  }

  .newsletter-popup__error ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .newsletter-popup__done .newsletter-popup__code {
    margin-top: 8px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .newsletter-popup__footnote {
    max-width: 92cqw;
    margin: auto 0 0;
    padding-top: 8cqw;
    font-family: var(--font-body);
    font-weight: 300;
    font-size: max(9px, 2.3cqw);
    line-height: 1.45;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Newsletter pop-up",
  "class": "section-newsletter-popup",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show the pop-up",
      "default": true,
      "info": "In the editor it opens while this section is selected."
    },
    {
      "type": "range",
      "id": "delay",
      "label": "Opens after",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "s",
      "default": 3
    },
    {
      "type": "range",
      "id": "days",
      "label": "After it is closed, show it again in",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "d",
      "default": 7,
      "info": "0 shows it again on the next visit. It shows once per visit, and never again for a year after a sign-up."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show the Cucuyo icon",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Title",
      "default": "Welcome"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Sign up for our newsletter and receive 10% off your first order for a limited time.</p>"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email field text",
      "default": "email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button",
      "default": "submit"
    },
    {
      "type": "textarea",
      "id": "footnote",
      "label": "Bottom line",
      "default": "Cucuyo Home is a curated multi-brand shop featuring objects from around the world that showcase the work of artisans, artists, and designers.",
      "info": "Shown in capitals."
    },
    {
      "type": "header",
      "content": "After signing up"
    },
    {
      "type": "richtext",
      "id": "success_text",
      "label": "Thank-you message",
      "default": "<p>Thank you for signing up.</p>"
    },
    {
      "type": "text",
      "id": "discount_code",
      "label": "Discount code",
      "info": "Shown under the message. Create it in Discounts first; leave empty if the code goes out by email."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "Background",
      "default": "#5D3F1F"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "color_detail",
      "label": "Email line and field text",
      "default": "#8C6D3A"
    }
  ]
}
{% endschema %}
