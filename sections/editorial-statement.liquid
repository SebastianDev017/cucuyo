{%- comment -%}
  Editorial statement — a wide-tracked PersonaTRIAL manifesto line on cream,
  centered, with an optional small-caps eyebrow and link. The typographic
  breather between image-heavy rows.
{%- endcomment -%}

<section class="statement statement--{{ section.settings.size }}">
  <div class="statement__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="statement__eyebrow type-label">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="statement__heading">{{ section.settings.heading | escape | newline_to_br }}</h2>
    {%- endif -%}
    {%- if section.settings.link_label != blank and section.settings.link != blank -%}
      <a href="{{ section.settings.link }}" class="statement__link type-label">{{ section.settings.link_label | escape }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Editorial statement",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Cucuyo Home"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Statement",
      "default": "A collection of distinctive decor,\nartisan-made pieces, and timeless finds\nsourced from around the world."
    },
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "options": [
        { "value": "regular", "label": "Regular" },
        { "value": "large", "label": "Large" }
      ],
      "default": "regular"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Editorial statement"
    }
  ]
}
{% endschema %}
