{%- comment -%}
  Header — Figma: transparent overlay on the homepage hero with the wordmark
  centered top and a stacked two-group nav in the top-left corner (menu links
  + search / account / cart). On inner pages it renders solid on the cream
  background with the nav in a centered row. No JS required.
{%- endcomment -%}
{%- liquid
  assign overlay = false
  if template.name == 'index' and section.settings.overlay_on_home
    assign overlay = true
  endif
-%}

<header class="site-header {% if overlay %}site-header--overlay{% else %}site-header--solid{% endif %}">
  <a href="{{ routes.root_url }}" class="site-header__logo">
    {{- section.settings.wordmark | default: shop.name -}}
  </a>

  <nav class="site-header__nav" aria-label="{{ 'accessibility.primary_navigation' | t }}">
    <div class="site-header__nav-inner">
      {%- if section.settings.menu != blank -%}
        <ul class="site-header__nav-list" role="list">
          {%- for link in section.settings.menu.links -%}
            <li>
              <a
                href="{{ link.url }}"
                class="site-header__link"
                {% if link.current %}
                  aria-current="page"
                {% endif %}
              >
                {{- link.title -}}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <ul class="site-header__nav-list" role="list">
        {%- if section.settings.show_search -%}
          <li><a href="{{ routes.search_url }}" class="site-header__link">{{ 'general.search.title' | t }}</a></li>
        {%- endif -%}
        {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
          <li><a href="{{ routes.account_url }}" class="site-header__link">{{ 'sections.header.account' | t }}</a></li>
        {%- endif -%}
        <li>
          <a href="{{ routes.cart_url }}" class="site-header__link">
            {{ 'sections.header.cart' | t }}
            <span class="visually-hidden">({{ cart.item_count }})</span>
          </a>
        </li>
      </ul>
    </div>
  </nav>
</header>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    {
      "type": "text",
      "id": "wordmark",
      "label": "Wordmark",
      "default": "CUCUYO HOME",
      "info": "Rendered in PersonaTRIAL. Leave as the brand wordmark."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "overlay_on_home",
      "label": "Transparent overlay on the homepage",
      "default": true,
      "info": "Lays the header over the hero images, as in the design"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search link",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account link",
      "default": true
    }
  ]
}
{% endschema %}
