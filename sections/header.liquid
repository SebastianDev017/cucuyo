{%- comment -%}
  Header — fixed overlay with NO background (Figma): all links stacked in one
  column top-left (primary menu group, then search / account / cart below),
  wordmark centered, light text over the hero. It stays fixed while scrolling
  (spartan-shop.com behavior, inspected live) and has NO transitions of any
  kind — no background fade, no color/font change, no hover animation on any
  level. Nested menu items render ALWAYS EXPANDED, indented under their
  parent (no dropdowns, nothing on click) — up to three levels
  (SHOP > category > sub). No JS required.
{%- endcomment -%}

<header class="site-header">
  <nav class="site-header__nav site-header__nav--primary" aria-label="{{ 'accessibility.primary_navigation' | t }}">
    <ul class="site-header__list" role="list">
      {%- for link in section.settings.menu.links -%}
        <li class="site-header__item">
          <a
            href="{{ link.url }}"
            class="site-header__link"
            {% if link.current %}
              aria-current="page"
            {% endif %}
          >
            {{- link.title -}}
          </a>
          {%- if link.links != blank -%}
            <ul class="site-header__sub" role="list">
              {%- for child in link.links -%}
                <li>
                  <a
                    href="{{ child.url }}"
                    class="site-header__link site-header__link--sub"
                    {% if child.current %}
                      aria-current="page"
                    {% endif %}
                  >
                    {{- child.title -}}
                  </a>
                  {%- if child.links != blank -%}
                    <ul class="site-header__sub site-header__sub--deep" role="list">
                      {%- for grandchild in child.links -%}
                        <li>
                          <a
                            href="{{ grandchild.url }}"
                            class="site-header__link site-header__link--deep"
                            {% if grandchild.current %}
                              aria-current="page"
                            {% endif %}
                          >
                            {{- grandchild.title -}}
                          </a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

    <ul class="site-header__list site-header__list--utilities" role="list">
      {%- if section.settings.show_search -%}
        <li><a href="{{ routes.search_url }}" class="site-header__link">{{ 'general.search.title' | t }}</a></li>
      {%- endif -%}
      {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
        <li><a href="{{ routes.account_url }}" class="site-header__link">{{ 'sections.header.account' | t }}</a></li>
      {%- endif -%}
      <li>
        <a href="{{ routes.cart_url }}" class="site-header__link">
          {{ 'sections.header.cart' | t }}
          <span class="visually-hidden">({{ cart.item_count }})</span>
        </a>
      </li>
    </ul>
  </nav>

  <a href="{{ routes.root_url }}" class="site-header__logo">
    {{- section.settings.wordmark | default: shop.name -}}
  </a>
</header>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    {
      "type": "text",
      "id": "wordmark",
      "label": "Wordmark",
      "default": "CUCUYO HOME",
      "info": "Rendered in PersonaTRIAL. Leave as the brand wordmark."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu",
      "info": "Nested links render always expanded, indented under their parent (up to 3 levels)"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search link",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account link",
      "default": true
    }
  ]
}
{% endschema %}
