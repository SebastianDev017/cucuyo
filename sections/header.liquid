{%- comment -%}
  Header — no background of its own at the top of the page. Two layouts from
  one markup:

  1200px and up, EVERY TEMPLATE: one row (Eugenia's comp) — wordmark flush
  left, the menu beside it, search / account / cart at the far right.

  Below 1200px (JS available): a bar — hamburger left, wordmark right — and
  the menu moves into a native <dialog> drawer (100dvh, width from the "Menu
  drawer width" theme setting): wordmark, the menu, utilities with a live cart
  count, and the newsletter form. Without JS the stacked overlay column stays,
  so the menu is never unreachable.

  Scrolling, on every template and layout: transparent at the top (over the
  first band's photographs on home, over the page elsewhere), hidden on the
  way down, sliding back on a solid ground on the way up — modelled on
  hereustudio.com; see initStickyHeader in theme.js. Layout lives in base.css.

  The colour of the type while it is transparent is the merchant's: one
  setting for the homepage (over a photograph) and one for every other page
  (over the page background), because a colour that reads on one can vanish
  on the other. Empty keeps the automatic colour.
{%- endcomment -%}

{%- liquid
  # The theme editor can materialize an untouched link_list picker as "" on
  # save, silently dropping the schema default — fall back to main-menu so
  # the nav never renders empty. An explicit merchant selection still wins.
  assign header_menu = section.settings.menu
  if header_menu == blank
    assign header_menu = linklists['main-menu']
  endif

  assign top_ink = section.settings.transparent_ink_pages
  assign top_scrim = false
  if template.name == 'index'
    assign top_ink = section.settings.transparent_ink_home
    assign top_scrim = section.settings.transparent_scrim_home
  endif
-%}

<header
  class="site-header{% if top_ink != blank %} site-header--top-ink{% endif %}{% if top_scrim %} site-header--top-scrim{% endif %}"
  {%- if top_ink != blank %} style="--header-top-ink: {{ top_ink }};"{% endif %}
>
  <button
    type="button"
    class="site-header__burger"
    data-drawer-open
    aria-expanded="false"
    aria-controls="NavDrawer"
    aria-haspopup="dialog"
  >
    <span class="visually-hidden">{{ 'accessibility.open_menu' | t }}</span>
    <span class="site-header__burger-lines" aria-hidden="true"></span>
  </button>

  <nav class="site-header__nav site-header__nav--primary" aria-label="{{ 'accessibility.primary_navigation' | t }}">
    {% render 'nav-links', menu: header_menu %}

    <ul class="site-header__list site-header__list--utilities" role="list">
      {%- if section.settings.show_search -%}
        <li><a href="{{ routes.search_url }}" class="site-header__link">{{ 'general.search.title' | t }}</a></li>
      {%- endif -%}
      {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
        <li><a href="{{ routes.account_url }}" class="site-header__link">{{ 'sections.header.account' | t }}</a></li>
      {%- endif -%}
      <li>
        <a href="{{ routes.cart_url }}" class="site-header__link">
          {{ 'sections.header.cart' | t }}
          <span class="visually-hidden">(<span data-cart-count>{{ cart.item_count }}</span>)</span>
        </a>
      </li>
    </ul>
  </nav>

  <a href="{{ routes.root_url }}" class="site-header__logo">
    {{- section.settings.wordmark | default: shop.name -}}
  </a>

  <dialog id="NavDrawer" class="nav-drawer" aria-modal="true" aria-label="{{ 'accessibility.primary_navigation' | t }}">
    <div class="nav-drawer__inner">
      <div class="nav-drawer__top">
        <a href="{{ routes.root_url }}" class="nav-drawer__logo">
          {{- section.settings.wordmark | default: shop.name -}}
        </a>
        <button type="button" class="nav-drawer__close" data-drawer-close>
          <span class="visually-hidden">{{ 'accessibility.close' | t }}</span>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
            <path d="M2 2l12 12M14 2L2 14" stroke="currentColor" stroke-width="1"/>
          </svg>
        </button>
      </div>

      <nav class="nav-drawer__nav" aria-label="{{ 'accessibility.primary_navigation' | t }}">
        {% render 'nav-links', menu: header_menu %}

        <ul class="site-header__list site-header__list--utilities" role="list">
          {%- if section.settings.show_search -%}
            <li><a href="{{ routes.search_url }}" class="site-header__link">{{ 'general.search.title' | t }}</a></li>
          {%- endif -%}
          {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
            <li><a href="{{ routes.account_url }}" class="site-header__link">{{ 'sections.header.account' | t }}</a></li>
          {%- endif -%}
          <li>
            <a href="{{ routes.cart_url }}" class="site-header__link">
              {{ 'sections.header.cart' | t }} (<span data-cart-count>{{ cart.item_count }}</span>)
            </a>
          </li>
        </ul>
      </nav>

      <div class="nav-drawer__newsletter">
        {% render 'newsletter-form', form_id: 'NavDrawerNewsletter', input_id: 'NavDrawerEmail' %}
        {%- if section.settings.drawer_note != blank -%}
          <p class="nav-drawer__note">{{ section.settings.drawer_note }}</p>
        {%- endif -%}
      </div>
    </div>
  </dialog>
</header>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    {
      "type": "text",
      "id": "wordmark",
      "label": "Wordmark",
      "default": "CUCUYO HOME",
      "info": "Rendered in PersonaTRIAL. Leave as the brand wordmark."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu",
      "info": "Nested links render always expanded, indented under their parent (up to 3 levels)"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search link",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account link",
      "default": true
    },
    {
      "type": "text",
      "id": "drawer_note",
      "label": "Drawer newsletter note",
      "default": "Sign up to our newsletter to receive exclusive offers.",
      "info": "Shown under the newsletter form in the mobile menu drawer"
    },
    {
      "type": "header",
      "content": "Transparent header"
    },
    {
      "type": "paragraph",
      "content": "At the top of every page, before scrolling, the header has no background. These set the colour of the wordmark, the links and the menu icon while it is transparent. Once the page scrolls, it comes back on white in the theme's own colours."
    },
    {
      "type": "color",
      "id": "transparent_ink_home",
      "label": "Text colour on the homepage",
      "info": "Over the first photograph. Leave empty to follow the first section's header tone."
    },
    {
      "type": "checkbox",
      "id": "transparent_scrim_home",
      "label": "Soften the photograph under the header on the homepage",
      "default": false,
      "info": "A gradient at the top of the first photograph while the header is transparent, so light type reads on a pale picture."
    },
    {
      "type": "color",
      "id": "transparent_ink_pages",
      "label": "Text colour on every other page",
      "info": "These pages start on the page background, so pick a colour that reads on it. Leave empty for the theme's accent."
    }
  ]
}
{% endschema %}
