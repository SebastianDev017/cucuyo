{%- comment -%}
  Cart page — works entirely without JS: {% form 'cart' %} posts positional
  updates[] quantities, Remove uses item.url_to_remove, and the two submit
  buttons are name="update" / name="checkout". Content is capped and
  centered on the content-area axis (the padded main handles the sidebar
  gutter + nav clearance like every non-home template).
{%- endcomment -%}

<section class="main-cart">
  <h1 class="main-cart__title">{{ 'cart.title' | t }}</h1>

  {%- if cart.item_count > 0 -%}
    {%- form 'cart', cart, class: 'cart-form' -%}
      <ul class="cart-lines" role="list">
        {%- for item in cart.items -%}
          <li class="cart-line">
            <a href="{{ item.url }}" class="cart-line__media">
              {%- if item.image -%}
                {{-
                  item.image
                  | image_url: width: 240
                  | image_tag: widths: '120, 240', sizes: '88px', alt: item.title
                -}}
              {%- else -%}
                <span class="cart-line__media-empty" aria-hidden="true"></span>
              {%- endif -%}
            </a>

            <div class="cart-line__info">
              <a href="{{ item.url }}" class="cart-line__name">{{ item.product.title }}</a>
              {%- unless item.product.has_only_default_variant -%}
                <p class="cart-line__variant">{{ item.variant.title }}</p>
              {%- endunless -%}
              <a href="{{ item.url_to_remove }}" class="cart-line__remove">{{ 'cart.remove' | t }}</a>
            </div>

            <div class="cart-line__qty">
              <label class="visually-hidden" for="Quantity-{{ forloop.index }}">{{ 'cart.quantity' | t }}</label>
              <input
                id="Quantity-{{ forloop.index }}"
                class="cart-line__qty-input"
                type="number"
                name="updates[]"
                value="{{ item.quantity }}"
                min="0"
                inputmode="numeric"
              >
            </div>

            <p class="cart-line__total">{{ item.final_line_price | money }}</p>
          </li>
        {%- endfor -%}
      </ul>

      <div class="cart-actions">
        <button type="submit" name="update" class="button--quiet">{{ 'cart.update' | t }}</button>

        <div class="cart-summary">
          <p class="cart-summary__subtotal">
            <span>{{ 'cart.subtotal' | t }}</span>
            <span>{{ cart.total_price | money }}</span>
          </p>
          <p class="cart-summary__note">{{ 'cart.taxes_note' | t }}</p>
          <button type="submit" name="checkout" class="button cart-summary__checkout">
            {{ 'cart.checkout' | t }}
          </button>
        </div>
      </div>
    {%- endform -%}
  {%- else -%}
    <div class="main-cart__empty">
      <p>{{ 'cart.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="button">{{ 'cart.continue_shopping' | t }}</a>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Cart page",
  "settings": []
}
{% endschema %}
