{%- comment -%}
  Highlighted content — a full-bleed lifestyle moment between the grids
  (Figma: 1512×835). Takes a hosted video (muted, looping, plays inline) or
  an image; the draft asset fills in while neither is selected. Optional link.
{%- endcomment -%}

<section class="image-band" data-header-tone="{{ section.settings.header_tone }}">
  {%- if section.settings.link != blank -%}<a href="{{ section.settings.link }}">{%- endif -%}
  {%- if section.settings.video -%}
    {%- comment -%}
      Hand-written <video> instead of video_tag so iOS/WebKit sees the bare
      boolean attributes it expects for muted inline autoplay. theme.js adds
      a declarative-first retry (property muted + play() on view/bfcache)
      for the WebKit cases that ignore the attributes alone.
    {%- endcomment -%}
    <video
      class="image-band__media"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      poster="{{ section.settings.video.preview_image | image_url: width: 1600 }}"
      {% if section.settings.alt_text != blank %}
        aria-label="{{ section.settings.alt_text | escape }}"
      {% endif %}
      data-autoplay-video
    >
      {%- for source in section.settings.video.sources -%}
        <source src="{{ source.url }}" type="{{ source.mime_type }}">
      {%- endfor -%}
    </video>
  {%- else -%}
    {% render 'draft-image',
      image: section.settings.image,
      draft_asset: section.settings.draft_asset,
      img_class: 'image-band__media',
      sizes: '100vw',
      alt: section.settings.alt_text,
      asset_width: 1512,
      asset_height: 835
    %}
  {%- endif -%}
  {%- if section.settings.link != blank -%}</a>{%- endif -%}
</section>

{% schema %}
{
  "name": "Highlighted content",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "header_tone",
      "label": "Header ink over this section",
      "options": [
        { "value": "light", "label": "Light (over dark imagery)" },
        { "value": "ink", "label": "Ink (over pale imagery)" }
      ],
      "default": "light",
      "info": "Home only — the header has no background, so its colour follows the section passing under it"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Plays muted on a loop. Takes priority over the image."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "draft_asset",
      "label": "Draft asset filename",
      "info": "Theme asset shown while no video or image is selected (design draft)"
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "Media description",
      "info": "Describes the image or video for screen readers"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Highlighted content"
    }
  ]
}
{% endschema %}
