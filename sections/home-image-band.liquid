{%- comment -%}
  Full-bleed image band — Figma: a single full-width lifestyle image
  (1512×835) between the card grids. Optional link.
{%- endcomment -%}

<section class="image-band">
  {%- if section.settings.link != blank -%}<a href="{{ section.settings.link }}">{%- endif -%}
  {% render 'draft-image',
    image: section.settings.image,
    draft_asset: section.settings.draft_asset,
    img_class: 'image-band__media',
    sizes: '100vw',
    alt: section.settings.alt_text,
    asset_width: 1512,
    asset_height: 835
  %}
  {%- if section.settings.link != blank -%}</a>{%- endif -%}
</section>

{% schema %}
{
  "name": "Image band",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "draft_asset",
      "label": "Draft asset filename",
      "info": "Theme asset shown while no image is selected (design draft)"
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "Image description",
      "info": "Describes the image for screen readers"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Image band"
    }
  ]
}
{% endschema %}
