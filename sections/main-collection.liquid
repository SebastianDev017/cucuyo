{%- comment -%}
  Collection page (reference: hereustudio.com collection grid, adapted to
  Cucuyo) — centered title with the shared heading style, the collection's
  native description below it when set, then the SAME editable-columns card
  grid as Featured collection (2-5 desktop, 1-2 mobile). The first product
  of the merchant's sort order takes an oversized 2×2 lead slot on page one
  — automatic, no manual "featured" flag. Cards are name + price only: no
  variant selector, no swatches (the card keeps an empty slot where the
  selector will eventually go). No filters yet.
{%- endcomment -%}

{%- paginate collection.products by section.settings.products_per_page -%}
  <section class="main-collection">
    <header class="collection-head">
      <h1 class="collection-head__title">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="collection-head__description rte">{{ collection.description }}</div>
      {%- endif -%}
    </header>

    {%- if collection.products.size > 0 -%}
      {%- liquid
        comment
          CONTEXT IMAGES sit in the grid as ordinary slots, so the products
          simply flow around them: the loop walks slot numbers, hands a slot
          to a context block when one claims that position, and otherwise
          takes the next product. Nothing is skipped — the products keep their
          order and none is displaced off the page.

          They only appear on page one. A position is a place in the grid the
          merchant is composing, and that composition does not repeat itself
          down page four.
        endcomment
        assign context_count = 0
        if paginate.current_page == 1
          for b in section.blocks
            if b.type == 'context_image'
              assign context_count = context_count | plus: 1
            endif
          endfor
        endif
        assign slot_count = collection.products.size | plus: context_count

        # The oversized lead product stands down on its own when a context
        # image already claims a large tile in the same band. The lead spans
        # the first two grid rows, so that band holds it plus the normal cards
        # beside it: 2 rows x columns, minus the 4 cells the lead itself takes,
        # plus the lead's own slot. A context image landing anywhere inside it
        # would sit beside or directly under the lead — two large tiles at
        # once, which is the thing this avoids. Past that band they no longer
        # meet, so the lead keeps its size.
        #
        # The setting stays a manual override: off is off, always. This only
        # ever demotes, never promotes.
        assign feature_first = section.settings.feature_first
        if feature_first and context_count > 0
          assign lead_band = section.settings.columns_desktop | times: 2 | minus: 3
          if lead_band < 1
            assign lead_band = 1
          endif
          for b in section.blocks
            if b.type == 'context_image' and b.settings.position <= lead_band
              assign feature_first = false
              break
            endif
          endfor
        endif
      -%}
      <div
        class="card-grid collection-grid"
        style="--cols-desktop: {{ section.settings.columns_desktop }}; --cols-mobile: {{ section.settings.columns_mobile }};"
      >
        {%- assign product_index = 0 -%}
        {%- for slot in (1..slot_count) -%}
          {%- liquid
            assign context_block = null
            if context_count > 0
              for b in section.blocks
                if b.type == 'context_image' and b.settings.position == slot
                  assign context_block = b
                  break
                endif
              endfor
            endif
          -%}

          {%- if context_block -%}
            {%- comment -%}
              No link, no heading, no price — it is a photograph, not a card.
              aria-hidden because it carries no information a screen reader
              can act on; its alt would only repeat what the page already says.
            {%- endcomment -%}
            <div class="context-image" {{ context_block.shopify_attributes }}>
              {% render 'media-image',
                image: context_block.settings.image,
                image_url: context_block.settings.image_url,
                img_class: 'context-image__media',
                sizes: '(min-width: 990px) 50vw, 100vw',
                alt: context_block.settings.alt_text
              %}
            </div>
          {%- else -%}
            {%- liquid
              assign product = collection.products[product_index]
              assign product_index = product_index | plus: 1
              assign is_featured = false
              if feature_first and paginate.current_page == 1 and product_index == 1
                assign is_featured = true
              endif
            -%}
            {%- if product -%}
              {% render 'product-card',
                product: product,
                featured: is_featured,
                show_collection: section.settings.show_collection_label
              %}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="collection-empty">{{ 'collections.empty' | t }}</p>
    {%- endif -%}

    {% render 'pagination', paginate: paginate %}
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection page",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 12,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1"
    },
    {
      "type": "checkbox",
      "id": "show_collection_label",
      "label": "Show collection label",
      "default": true,
      "info": "The product's category, under its name. Comes from the collection whose title matches the product's Type, so it stays the real category even when a product sits in several collections."
    },
    {
      "type": "checkbox",
      "id": "feature_first",
      "label": "Oversized first product",
      "default": true,
      "info": "The first product leads the grid at double size. It steps back to a normal card on its own when a context image already takes a large tile beside it, so there is never more than one large tile up top. Turn this off to keep the large slots for context images only."
    }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "context_image",
      "name": "Context image",
      "settings": [
        {
          "type": "paragraph",
          "content": "A mood or lifestyle photograph placed among the products. It takes a large slot and carries no name, price or link — it never behaves like a product."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Image URL",
          "info": "Used when nothing is uploaded. Uploads are sharper."
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Image description",
          "info": "For screen readers. Leave empty if the photo is purely decorative."
        },
        {
          "type": "range",
          "id": "position",
          "label": "Position in the grid",
          "min": 1,
          "max": 24,
          "step": 1,
          "default": 1,
          "info": "Counting every slot, products included. Page one only."
        }
      ]
    }
  ]
}
{% endschema %}
