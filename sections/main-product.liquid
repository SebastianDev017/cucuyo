{%- comment -%}
  Product page (Figma "product pg 1") — portrait image column left (4:5 per
  the approved Figma; the v1 STYLE-GUIDE's 3:4 was superseded), info panel
  right: breadcrumb (dynamic from the product's real collection), title,
  description, accordion rows with accent hairlines and +/− markers, and an
  ADD TO CART button with the price built into the label behind a thin
  divider. The variant <select> carries name="id" so the right variant
  submits without JS; theme.js progressively updates the price/availability.
{%- endcomment -%}
{%- assign current_variant = product.selected_or_first_available_variant -%}

<section class="main-product" style="--media-ratio: {{ section.settings.media_ratio }};">
  <div class="main-product__grid">
    <div class="main-product__media">
      {%- assign product_images = product.media | where: 'media_type', 'image' -%}
      {%- if product_images.size > 0 -%}
        <div class="main-product__media-item main-product__media-item--hero">
          {{-
            product_images.first
            | image_url: width: 1500
            | image_tag:
              widths: '550, 750, 1100, 1500',
              sizes: '(min-width: 750px) 40vw, 100vw',
              loading: 'eager',
              fetchpriority: 'high'
          -}}
        </div>
      {%- else -%}
        <div class="main-product__media-item main-product__media-item--empty" aria-hidden="true"></div>
      {%- endif -%}

      {%- comment -%}
        Gallery: every image after the hero, stacked in document order under
        it, full column width, height from the image's own aspect ratio.
        Nothing is ever cropped here — editorial rule. A single-image product
        renders no gallery at all (no empty state, no placeholder).
      {%- endcomment -%}
      {%- if product_images.size > 1 -%}
        <div class="pdp-gallery">
          {%- for media in product_images offset: 1 -%}
            <div class="pdp-gallery__item">
              {{-
                media
                | image_url: width: 1500
                | image_tag:
                  widths: '550, 750, 1100, 1500',
                  sizes: '(min-width: 750px) 40vw, 100vw',
                  loading: 'lazy'
              -}}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="main-product__info">
      {%- if section.settings.show_breadcrumb -%}
        <nav class="breadcrumb" aria-label="{{ 'accessibility.breadcrumb' | t }}">
          <a href="{{ routes.all_products_collection_url }}" class="breadcrumb__link">{{ 'general.breadcrumb.shop' | t }}</a>
          {%- comment -%}
            When the visitor arrived through a collection, that collection is
            the crumb. Otherwise fall back to the product's own category.
          {%- endcomment -%}
          {%- if collection -%}
            <span class="breadcrumb__separator" aria-hidden="true">&gt;</span>
            <a href="{{ collection.url }}" class="breadcrumb__link">{{ collection.title }}</a>
          {%- else -%}
            {% render 'product-category', product: product, as: 'link' %}
          {%- endif -%}
        </nav>
      {%- endif -%}

      {%- if section.settings.show_vendor and product.vendor != blank -%}
        <p class="main-product__vendor type-label">{{ product.vendor }}</p>
      {%- endif -%}

      <h1 class="main-product__title">{{ product.title }}</h1>

      {%- if product.description != blank -%}
        <div class="main-product__description rte">{{ product.description }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="main-product__accordions">
          {%- for block in section.blocks -%}
            <details class="accordion" {{ block.shopify_attributes }}>
              <summary class="accordion__summary">
                <span class="accordion__title">{{ block.settings.title }}</span>
                <span class="accordion__icon" aria-hidden="true"></span>
              </summary>
              <div class="accordion__content rte">{{ block.settings.content }}</div>
            </details>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div
        class="main-product__form"
        data-product-form
        data-add-text="{{ 'products.add_to_cart' | t | escape }}"
        data-sold-out-text="{{ 'products.sold_out' | t | escape }}"
        data-unavailable-text="{{ 'products.unavailable' | t | escape }}"
      >
        {%- form 'product', product, class: 'product-form' -%}
          {%- if product.variants.size > 1 -%}
            <label class="visually-hidden" for="Variants-{{ section.id }}">{{ 'products.select_variant' | t }}</label>
            <select id="Variants-{{ section.id }}" name="id" class="main-product__variant-select" data-variant-select>
              {%- for variant in product.variants -%}
                <option
                  value="{{ variant.id }}"
                  {% if variant == current_variant %}
                    selected
                  {% endif %}
                  {% unless variant.available %}
                    disabled
                  {% endunless %}
                >
                  {{ variant.title }}
                  {%- unless variant.available %} — {{ 'products.sold_out' | t }}{% endunless %}
                </option>
              {%- endfor -%}
            </select>
          {%- else -%}
            <input type="hidden" name="id" value="{{ current_variant.id }}">
          {%- endif -%}

          <button
            type="submit"
            class="button button--atc"
            data-add-button
            {% unless current_variant.available %}
              disabled
            {% endunless %}
          >
            {%- if current_variant.available -%}
              <span data-atc-label>{{ 'products.add_to_cart' | t }}</span>
              <span class="button--atc__divider" data-atc-divider aria-hidden="true"></span>
              <span data-atc-price aria-live="polite">{{ current_variant.price | money }}</span>
            {%- else -%}
              <span data-atc-label>{{ 'products.sold_out' | t }}</span>
              <span class="button--atc__divider" data-atc-divider aria-hidden="true" hidden></span>
              <span data-atc-price aria-live="polite" hidden></span>
            {%- endif -%}
          </button>
        {%- endform -%}

        <script type="application/json" data-variant-data>
          [
            {%- for variant in product.variants -%}
              {
                "id": {{ variant.id | json }},
                "available": {{ variant.available | json }},
                "price": {{ variant.price | money | json }}
              }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]
        </script>
      </div>
    </div>
  </div>

</section>

{% schema %}
{
  "name": "Product page",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Show breadcrumb",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Image aspect ratio",
      "options": [
        {
          "value": "3/4",
          "label": "Portrait 3:4"
        },
        {
          "value": "4/5",
          "label": "Portrait 4:5"
        },
        {
          "value": "1/1",
          "label": "Square"
        }
      ],
      "default": "4/5",
      "info": "Applies to the hero image only — gallery images are never cropped"
    }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Shipping & returns"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Share your shipping and returns policy here.</p>"
        }
      ]
    }
  ],
  "max_blocks": 6
}
{% endschema %}
