{%- comment -%}
  Project sequence — full-height photographs in a row that moves sideways,
  with nothing written over them.

  It moves when it is asked to: the two arrows above it (the same arrows and
  the same code as the product strips, snippets/product-strip + theme.js
  initProductStrips), a trackpad, a swipe, or the keyboard on the focused
  row. It used to pin itself to the screen and turn the page's own vertical
  scroll into sideways travel, which meant the whole row had to be scrolled
  through before the page would go on down (Jenn, 2026-09-24). That is gone.

  Each photograph is its own block: reorder by dragging, and a panel can be
  narrow or wide so the sequence has a rhythm instead of a filmstrip.
{%- endcomment -%}

<section
  class="story-sequence"
  data-product-strip
  style="
    {% render 'section-style', section: section %}
    --seq-height: {{ section.settings.panel_height | default: 100 }}svh;
    --seq-gap: {{ section.settings.gap | default: 6 }}px;
  "
>
  {%- if section.blocks.size > 0 -%}
    {%- liquid
      assign prev_label = 'general.strip.previous' | t
      assign next_label = 'general.strip.next' | t
    -%}
    <div class="product-strip__head story-sequence__head">
      <div class="product-strip__arrows" data-strip-arrows hidden>
        <button type="button" class="product-strip__arrow" data-strip-prev aria-controls="Sequence-{{ section.id }}" aria-label="{{ prev_label }}">
          <svg class="product-strip__chevron" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <path d="M15 4 L7 12 L15 20" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </button>
        <button type="button" class="product-strip__arrow" data-strip-next aria-controls="Sequence-{{ section.id }}" aria-label="{{ next_label }}">
          <svg class="product-strip__chevron" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <path d="M9 4 L17 12 L9 20" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </button>
      </div>
    </div>

    <div class="story-sequence__scroller">
      <div
        class="story-sequence__viewport"
        id="Sequence-{{ section.id }}"
        data-strip-track
        tabindex="0"
        role="region"
        aria-label="{{ section.settings.label | default: 'Projects' | escape }}"
      >
        <div class="story-sequence__track">
          {%- for block in section.blocks -%}
            <figure
              class="story-sequence__panel story-sequence__panel--{{ block.settings.width }}"
              data-strip-item
              {{ block.shopify_attributes }}
            >
              {% render 'media-image',
                image: block.settings.image,
                image_url: block.settings.image_url,
                draft_asset: block.settings.draft_asset,
                img_class: 'story-sequence__image',
                sizes: '(min-width: 750px) 60vw, 90vw',
                alt: block.settings.alt_text,
                asset_width: 1200,
                asset_height: 1800
              %}
            </figure>
          {%- endfor -%}
        </div>

      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Project sequence",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "The photographs move sideways with the arrows above them, a trackpad or a swipe. The page keeps scrolling down normally."
    },
    {
      "type": "range",
      "id": "panel_height",
      "label": "Photograph height",
      "min": 60,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "default": 100
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between photographs",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 6
    },
    {
      "type": "text",
      "id": "label",
      "label": "Name of this sequence",
      "default": "Projects",
      "info": "Read aloud by screen readers. Never shown on the page."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "info": "Empty uses the theme's"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "max_blocks": 12,
  "blocks": [
    {
      "type": "panel",
      "name": "Photograph",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Image URL",
          "info": "Used when nothing is uploaded. Uploads are sharper."
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Image description",
          "info": "For screen readers"
        },
        {
          "type": "text",
          "id": "draft_asset",
          "label": "Draft asset filename",
          "info": "Placeholder photograph used until an image is chosen"
        },
        {
          "type": "select",
          "id": "width",
          "label": "Width",
          "options": [
            {
              "value": "narrow",
              "label": "Narrow"
            },
            {
              "value": "wide",
              "label": "Wide"
            },
            {
              "value": "full",
              "label": "Full screen"
            }
          ],
          "default": "narrow"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Project sequence",
      "blocks": [
        {
          "type": "panel",
          "settings": {
            "draft_asset": "story-pink-planes.jpg",
            "width": "narrow"
          }
        },
        {
          "type": "panel",
          "settings": {
            "draft_asset": "story-linen-sofa.jpg",
            "width": "wide"
          }
        },
        {
          "type": "panel",
          "settings": {
            "draft_asset": "story-arcade.jpg",
            "width": "narrow"
          }
        },
        {
          "type": "panel",
          "settings": {
            "draft_asset": "story-hammock.jpg",
            "width": "wide"
          }
        },
        {
          "type": "panel",
          "settings": {
            "draft_asset": "story-dried-grass.jpg",
            "width": "narrow"
          }
        }
      ]
    }
  ]
}
{% endschema %}
