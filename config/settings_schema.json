[
  {
    "name": "theme_info",
    "theme_name": "Cucuyo",
    "theme_version": "2.0.0",
    "theme_author": "Cucuyo Home",
    "theme_documentation_url": "https://github.com/SebastianDev017/cucuyo",
    "theme_support_url": "https://github.com/SebastianDev017/cucuyo/issues"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "default": "#F9F6F2"
      },
      {
        "type": "color",
        "id": "color_ink",
        "label": "Text",
        "default": "#302C2C"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent",
        "default": "#623827",
        "info": "Buttons and key interactive elements"
      },
      {
        "type": "color",
        "id": "color_on_accent",
        "label": "Text on accent",
        "default": "#F9F6F2"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Muted text",
        "default": "#83695A",
        "info": "Footer links, captions, microcopy"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Borders",
        "default": "#D9CFC4"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "paragraph",
        "content": "Cucuyo self-hosts its brand fonts: PersonaTRIAL Medium for headings and labels, Junction for body text. They load from the theme's assets — no external requests."
      },
      {
        "type": "range",
        "id": "heading_scale",
        "label": "Heading size scale",
        "min": 80,
        "max": 130,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "range",
        "id": "body_scale",
        "label": "Body size scale",
        "min": 80,
        "max": 130,
        "step": 5,
        "unit": "%",
        "default": 100
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_margin",
        "label": "Page margin",
        "min": 16,
        "max": 64,
        "step": 4,
        "unit": "px",
        "default": 40,
        "info": "Outer padding for text content (header, labels, footer)"
      },
      {
        "type": "range",
        "id": "grid_gap",
        "label": "Grid gap",
        "min": 0,
        "max": 16,
        "step": 2,
        "unit": "px",
        "default": 4,
        "info": "Hairline gap between grid images, as in the design"
      },
      {
        "type": "range",
        "id": "drawer_width",
        "label": "Menu drawer width",
        "min": 50,
        "max": 90,
        "step": 5,
        "unit": "vw",
        "default": 80,
        "info": "Width of the mobile menu drawer (under 768px)"
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "header",
        "content": "Shape"
      },
      {
        "type": "select",
        "id": "card_shape",
        "label": "Card shape",
        "options": [
          {
            "value": "756/957",
            "label": "Portrait 4:5 (Figma)"
          },
          {
            "value": "3/4",
            "label": "Portrait 3:4"
          },
          {
            "value": "1/1",
            "label": "Square"
          },
          {
            "value": "5/4",
            "label": "Landscape 5:4"
          }
        ],
        "default": "756/957",
        "info": "The image ratio every product card is cropped to"
      },
      {
        "type": "header",
        "content": "Spacing"
      },
      {
        "type": "range",
        "id": "card_gap",
        "label": "Space between images",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "default": 6,
        "info": "The gap in the grid itself. Keep it small for a tight field of images — the text keeps its own space below."
      },
      {
        "type": "range",
        "id": "card_text_inset",
        "label": "Info padding (right)",
        "min": 0,
        "max": 60,
        "step": 2,
        "unit": "px",
        "default": 18,
        "info": "Horizontal room the text keeps to its right so one card's price never meets the next card's title. Raise this, not the gap, if they crowd."
      },
      {
        "type": "range",
        "id": "card_text_top",
        "label": "Info padding (top)",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "default": 14,
        "info": "Space between the image and the text below it"
      },
      {
        "type": "range",
        "id": "card_text_space",
        "label": "Info padding (bottom)",
        "min": 0,
        "max": 60,
        "step": 2,
        "unit": "px",
        "default": 26,
        "info": "Room under the text before the next row of images"
      },
      {
        "type": "header",
        "content": "Colour swatches"
      },
      {
        "type": "range",
        "id": "swatch_size",
        "label": "Swatch size",
        "min": 10,
        "max": 30,
        "step": 1,
        "unit": "px",
        "default": 16
      },
      {
        "type": "range",
        "id": "swatch_size_pdp",
        "label": "Swatch size (product page)",
        "min": 12,
        "max": 40,
        "step": 1,
        "unit": "px",
        "default": 22
      },
      {
        "type": "range",
        "id": "swatch_gap",
        "label": "Space between swatches",
        "min": 2,
        "max": 24,
        "step": 1,
        "unit": "px",
        "default": 8
      },
      {
        "type": "range",
        "id": "swatch_margin",
        "label": "Space above the swatches",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "default": 10
      }
    ]
  },
  {
    "name": "Animations",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_scroll_animations",
        "label": "Enable scroll animations",
        "default": true,
        "info": "Subtle fades and image reveals. Automatically disabled for visitors who prefer reduced motion."
      },
      {
        "type": "checkbox",
        "id": "enable_smooth_scroll",
        "label": "Enable smooth scrolling",
        "default": true
      }
    ]
  },
  {
    "name": "Branding",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Displayed at 32 × 32 px"
      }
    ]
  }
]
